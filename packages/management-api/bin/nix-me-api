#!/bin/bash

# Machine-readable backend for native and third-party nix-me clients.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
CONFIG_DIR="${NIX_ME_CONFIG_DIR:-$REPO_DIR}"
HOST_NAME="${NIX_ME_HOSTNAME:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"
APPLIED_MANIFEST="${NIX_ME_APPLIED_MANIFEST:-/etc/nix-me/manifest.json}"
API_VERSION=1
REQUESTED_ENDPOINT="${1:-snapshot}"

# GUI apps do not inherit the interactive shell PATH.
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-$(id -un)}/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
export USERNAME="${USERNAME:-${USER:-$(id -un)}}"

if ! command -v jq >/dev/null 2>&1; then
  printf '{"schemaVersion":1,"error":{"code":"missing_dependency","message":"jq is required by the nix-me API"}}\n'
  exit 69
fi

case "$REQUESTED_ENDPOINT" in
  snapshot | status | inventory | updates | projects | app-state | app-state-settings | local-ai | manifest)
    ;;
  *)
    jq -n --arg command "$REQUESTED_ENDPOINT" \
      '{schemaVersion: 1, error: {code: "unknown_endpoint", message: ("Unknown API endpoint: " + $command)}}'
    exit 64
    ;;
esac

TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/nix-me-api.XXXXXX")"
trap 'rm -rf "$TEMP_DIR"' EXIT

warnings='[]'

add_warning() {
  local message="$1"
  warnings="$(jq -c --arg message "$message" '. + [$message]' <<<"$warnings")"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

read_bundle_value() {
  local plist="$1"
  local key="$2"

  if [[ -x /usr/libexec/PlistBuddy ]]; then
    /usr/libexec/PlistBuddy -c "Print :$key" "$plist" 2>/dev/null || true
  elif command_exists plutil; then
    plutil -extract "$key" raw -o - "$plist" 2>/dev/null || true
  fi
}

discover_installed_applications() {
  local catalog_file app_directories application_directory application_path plist
  local bundle_id application_name catalog_lines
  local -a application_directories

  catalog_file="${NIX_ME_APPLICATION_CATALOG:-}"
  if [[ -n "$catalog_file" ]]; then
    if [[ -r "$catalog_file" ]] && jq -ce '
      (if type == "object" then .applications else . end) |
      select(type == "array") |
      map(select(
        (.name | type == "string" and length > 0) and
        (.bundleId | type == "string" and length > 0) and
        (.appPath | type == "string" and length > 0)
      ))
    ' "$catalog_file" 2>/dev/null; then
      return 0
    fi
    return 1
  fi

  catalog_lines="$TEMP_DIR/installed-applications.ndjson"
  : >"$catalog_lines"
  app_directories="${NIX_ME_APPLICATION_DIRS:-/Applications:$HOME/Applications}"
  IFS=':' read -r -a application_directories <<<"$app_directories"
  for application_directory in "${application_directories[@]}"; do
    [[ -d "$application_directory" ]] || continue
    while IFS= read -r -d '' application_path; do
      plist="$application_path/Contents/Info.plist"
      [[ -r "$plist" ]] || continue
      bundle_id="$(read_bundle_value "$plist" CFBundleIdentifier)"
      [[ -n "$bundle_id" ]] || continue
      application_name="$(read_bundle_value "$plist" CFBundleDisplayName)"
      [[ -n "$application_name" ]] || application_name="$(read_bundle_value "$plist" CFBundleName)"
      [[ -n "$application_name" ]] || application_name="$(basename "${application_path%.app}")"
      jq -cn \
        --arg name "$application_name" \
        --arg bundleId "$bundle_id" \
        --arg appPath "$application_path" \
        '{name: $name, bundleId: $bundleId, appPath: $appPath}' >>"$catalog_lines"
    done < <(find -L "$application_directory" -maxdepth 2 -type d -name '*.app' -prune -print0 2>/dev/null)
  done

  if [[ -s "$catalog_lines" ]]; then
    jq -sc 'unique_by(.bundleId) | sort_by(.name | ascii_downcase)' "$catalog_lines"
  else
    printf '[]\n'
  fi
}

configuration_relative_path() {
  local path="$1"
  if [[ "$path" == "$CONFIG_DIR/"* ]]; then
    printf '%s\n' "${path#"$CONFIG_DIR/"}"
  elif [[ "$path" == */packages/app-state/* ]]; then
    printf 'packages/app-state/%s\n' "${path#*"/packages/app-state/"}"
  elif [[ "$path" == */config/app-state/* ]]; then
    printf 'config/app-state/%s\n' "${path#*"/config/app-state/"}"
  else
    printf '%s\n' "$path"
  fi
}

values_file_has_application() {
  local file="$1"
  local app_id="$2"
  case "$file" in
    *.json) jq -e --arg appId "$app_id" 'type == "object" and has($appId)' "$file" >/dev/null 2>&1 ;;
    *.yaml | *.yml) grep -Eq "^${app_id}:[[:space:]]*($|#)" "$file" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

append_configuration_source() {
  local sources="$1"
  local scope="$2"
  local label="$3"
  local file="$4"
  local relative_path
  relative_path="$(configuration_relative_path "$file")"
  jq -c \
    --arg scope "$scope" \
    --arg label "$label" \
    --arg path "$relative_path" \
    '. + [{scope: $scope, label: $label, path: $path}]' <<<"$sources"
}

application_configuration_sources() {
  local app_id="$1"
  local sources='[]'
  local values_path file relative_path scope label profile

  for values_path in "${app_state_values_paths[@]}"; do
    [[ -n "$values_path" ]] || continue
    if [[ -d "$values_path" ]]; then
      while IFS= read -r file; do
        if values_file_has_application "$file" "$app_id"; then
          relative_path="$(configuration_relative_path "$file")"
          case "$relative_path" in
            packages/app-state/values/*) scope=builtIn; label="Built-in defaults" ;;
            config/app-state/shared/*) scope=shared; label="All machines" ;;
            config/app-state/profiles/*)
              scope=profile
              profile="${relative_path#config/app-state/profiles/}"
              label="Profile: ${profile%%/*}"
              ;;
            config/app-state/machines/*) scope=machine; label="This machine" ;;
            *) scope=external; label="Additional values" ;;
          esac
          sources="$(append_configuration_source "$sources" "$scope" "$label" "$file")"
        fi
      done < <(find "$values_path" -type f \( -name '*.json' -o -name '*.yaml' -o -name '*.yml' \) -print 2>/dev/null | sort)
    elif [[ -f "$values_path" ]] && values_file_has_application "$values_path" "$app_id"; then
      relative_path="$(configuration_relative_path "$values_path")"
      case "$relative_path" in
        packages/app-state/values/*) scope=builtIn; label="Built-in defaults" ;;
        config/app-state/shared/*) scope=shared; label="All machines" ;;
        config/app-state/profiles/*)
          scope=profile
          profile="${relative_path#config/app-state/profiles/}"
          label="Profile: ${profile%%/*}"
          ;;
        config/app-state/machines/*) scope=machine; label="This machine" ;;
        *) scope=external; label="Additional values" ;;
      esac
      sources="$(append_configuration_source "$sources" "$scope" "$label" "$values_path")"
    fi
  done

  printf '%s\n' "$sources"
}

application_recipe_path() {
  local app_id="$1"
  local recipe_root recipe_path
  for recipe_root in "${app_state_recipe_paths[@]}"; do
    if [[ -d "$recipe_root" ]]; then
      recipe_path="$(find "$recipe_root" -type f \( -name "$app_id.yaml" -o -name "$app_id.yml" \) -print -quit 2>/dev/null)"
    elif [[ "$(basename "$recipe_root")" == "$app_id.yaml" || "$(basename "$recipe_root")" == "$app_id.yml" ]]; then
      recipe_path="$recipe_root"
    else
      recipe_path=''
    fi
    if [[ -n "$recipe_path" ]]; then
      configuration_relative_path "$recipe_path"
      return 0
    fi
  done
  return 1
}

recipe_scalar() {
  local key="$1"
  local recipe="$2"
  awk -v key="$key" '
    $0 ~ ("^" key ":[[:space:]]*") {
      value = $0
      sub("^" key ":[[:space:]]*", "", value)
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }
      print value
      exit
    }
  ' "$recipe"
}

recipe_capture_kinds() {
  local recipe="$1"
  awk '
    function flush_entry() {
      if (kind == "defaults" || kind == "command" ||
          (kind == "file" && format != "" && format != "text") ||
          (kind == "file" && format == "text" && export == "reviewed_text")) {
        kinds[kind] = 1
      }
      kind = ""
      format = ""
      export = ""
    }

    /^config:[[:space:]]*$/ {
      in_config = 1
      next
    }

    in_config && /^[^[:space:]#]/ {
      flush_entry()
      in_config = 0
    }

    in_config && /^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/ {
      flush_entry()
      kind = $0
      sub(/^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/, "", kind)
      sub(/[[:space:]]+#.*/, "", kind)
      gsub(/[[:space:]]/, "", kind)
      next
    }

    in_config && kind == "file" && /^[[:space:]]+format:[[:space:]]*/ {
      format = $0
      sub(/^[[:space:]]+format:[[:space:]]*/, "", format)
      sub(/[[:space:]]+#.*/, "", format)
      gsub(/[[:space:]]/, "", format)
    }

    in_config && kind == "file" && /^[[:space:]]+export:[[:space:]]*/ {
      export = $0
      sub(/^[[:space:]]+export:[[:space:]]*/, "", export)
      sub(/[[:space:]]+#.*/, "", export)
      gsub(/[[:space:]]/, "", export)
    }

    END {
      if (in_config) {
        flush_entry()
      }
      for (kind_name in kinds) {
        print kind_name
      }
    }
  ' "$recipe" | sort
}

recipe_managed_paths() {
  local recipe="$1"
  awk '
    function clean(value) {
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }

    /^config:[[:space:]]*$/ {
      in_config = 1
      next
    }

    in_config && /^[^[:space:]#]/ {
      in_config = 0
    }

    in_config && /^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/ {
      kind = $0
      sub(/^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/, "", kind)
      kind = clean(kind)
      next
    }

    in_config && kind == "file" && /^[[:space:]]+path:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]+path:[[:space:]]*/, "", value)
      print clean(value)
    }

    in_config && kind == "generated_import" && /^[[:space:]]+deliver:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]+deliver:[[:space:]]*/, "", value)
      print clean(value)
    }
  ' "$recipe" | sort -u
}

recipe_manual_steps() {
  local recipe="$1"
  awk '
    function clean(value) {
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }

    /^config:[[:space:]]*$/ { in_config = 1; next }
    in_config && /^[^[:space:]#]/ { in_config = 0 }
    in_config && /^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/ {
      kind = $0
      sub(/^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/, "", kind)
      kind = clean(kind)
      next
    }
    in_config && kind == "manual" && /^[[:space:]]+step:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]+step:[[:space:]]*/, "", value)
      print clean(value)
    }
  ' "$recipe"
}

recipe_detect_command() {
  local recipe="$1"
  awk '
    function clean(value) {
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }

    /^detect:[[:space:]]*$/ { in_detect = 1; next }
    in_detect && /^[^[:space:]#]/ { in_detect = 0 }
    in_detect && /^[[:space:]]+command:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]+command:[[:space:]]*/, "", value)
      print clean(value)
      exit
    }
  ' "$recipe"
}

recipe_manual_marker_command() {
  local recipe="$1"
  awk '
    function clean(value) {
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }

    /^config:[[:space:]]*$/ { in_config = 1; next }
    in_config && /^[^[:space:]#]/ { in_config = 0 }
    in_config && /^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/ {
      kind = $0
      sub(/^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/, "", kind)
      kind = clean(kind)
      in_marker = 0
      next
    }
    in_config && kind == "manual" && /^[[:space:]]+marker:[[:space:]]*$/ {
      in_marker = 1
      next
    }
    in_config && kind == "manual" && in_marker && /^[[:space:]]+command:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]+command:[[:space:]]*/, "", value)
      print clean(value)
      exit
    }
  ' "$recipe"
}

private_state_exclusion_reason() {
  case "$1" in
    onepassword-cli)
      printf '%s\n' 'Account identity, email addresses, vaults, credentials, session tokens, and device trust remain on this Mac and are never exported.'
      ;;
    codex-cli)
      printf '%s\n' 'OAuth and API credentials, account identity, sessions, and conversation data remain on this Mac and are never exported.'
      ;;
    *) return 1 ;;
  esac
}

private_state_expected_detect() {
  case "$1" in
    onepassword-cli) printf '%s\n' 'command -v op >/dev/null 2>&1' ;;
    codex-cli) printf '%s\n' 'command -v codex >/dev/null 2>&1' ;;
    *) return 1 ;;
  esac
}

private_state_expected_marker() {
  case "$1" in
    onepassword-cli)
      printf '%s\n' "command -v op >/dev/null 2>&1 && op --version 2>/dev/null | grep -Eq '^2\\.' && op whoami --help >/dev/null 2>&1 && op whoami --format=json >/dev/null 2>&1"
      ;;
    codex-cli)
      printf '%s\n' 'command -v codex >/dev/null 2>&1 && codex login status --help >/dev/null 2>&1 && codex login status >/dev/null 2>&1'
      ;;
    *) return 1 ;;
  esac
}

run_bounded_private_state_plan() {
  local output_file="$1"
  shift
  local timeout_seconds="${NIX_ME_PRIVATE_STATE_TIMEOUT_SECONDS:-5}"
  local max_ticks ticks pid status

  if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || ((timeout_seconds > 15)); then
    timeout_seconds=5
  fi
  max_ticks=$((timeout_seconds * 10))
  ticks=0

  "$@" >"$output_file" 2>/dev/null &
  pid=$!
  while kill -0 "$pid" >/dev/null 2>&1; do
    if ((ticks >= max_ticks)); then
      kill "$pid" >/dev/null 2>&1 || true
      sleep 0.1
      kill -9 "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
      return 124
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done

  wait "$pid"
  status=$?
  return "$status"
}

private_state_metadata() {
  local app_id="$1"
  local recipe_file="$2"
  local exclusion_reason expected_detect expected_marker actual_detect actual_marker
  local readiness='unknown'
  local values_file plan_file

  exclusion_reason="$(private_state_exclusion_reason "$app_id")" || return 1
  expected_detect="$(private_state_expected_detect "$app_id")" || return 1
  expected_marker="$(private_state_expected_marker "$app_id")" || return 1

  if [[ "$REQUESTED_ENDPOINT" =~ ^(snapshot|app-state-settings)$ ]] &&
    [[ -n "$app_state_engine" && -x "$app_state_engine" && -f "$recipe_file" ]]; then
    actual_detect="$(recipe_detect_command "$recipe_file")"
    actual_marker="$(recipe_manual_marker_command "$recipe_file")"
    if [[ "$actual_detect" == "$expected_detect" && "$actual_marker" == "$expected_marker" ]]; then
      values_file="$TEMP_DIR/private-state-$app_id-values.json"
      plan_file="$TEMP_DIR/private-state-$app_id-plan.json"
      jq -cn --arg appId "$app_id" '{($appId): {}}' >"$values_file"
      run_bounded_private_state_plan "$plan_file" \
        "$app_state_engine" diff \
        --json \
        --no-exec \
        --skip-missing \
        --recipe "$recipe_file" \
        --values "$values_file" \
        --only "$app_id" || true

      if jq -e --arg appId "$app_id" '
        type == "object" and
        (.checklist | type == "array") and
        ([.checklist[] | select(.app == $appId and (.satisfied | type == "boolean"))] | length) == 1
      ' "$plan_file" >/dev/null 2>&1; then
        if jq -e --arg appId "$app_id" '
          any(.checklist[]; .app == $appId and .satisfied == true)
        ' "$plan_file" >/dev/null 2>&1; then
          readiness='ready'
        else
          readiness='notReady'
        fi
      elif jq -e '
        type == "object" and (.apps | type == "array") and (.checklist | type == "array")
      ' "$plan_file" >/dev/null 2>&1; then
        readiness='notReady'
      fi
    fi
  fi

  jq -cn \
    --arg readiness "$readiness" \
    --arg exclusionReason "$exclusion_reason" \
    '{readiness: $readiness, exclusionReason: $exclusionReason}'
}

recipe_exportable_settings() {
  local recipe="$1"
  awk '
    function clean(value) {
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }

    function flush_entry() {
      if (kind == "file" && format != "" && format != "text" && path != "") {
        print "file\tStructured settings file\t" path "\tfalse"
      } else if (kind == "file" && format == "text" && export == "reviewed_text" && path != "") {
        print "file\tReviewed text settings file\t" path "\ttrue"
      } else if (kind == "command" && name != "") {
        print "command\tApplication-managed list\t" name "\tfalse"
      }
      kind = ""
      domain = ""
      path = ""
      format = ""
      export = ""
      name = ""
      in_keys = 0
    }

    /^config:[[:space:]]*$/ { in_config = 1; next }
    in_config && /^[^[:space:]#]/ {
      flush_entry()
      in_config = 0
    }
    in_config && /^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/ {
      flush_entry()
      kind = $0
      sub(/^[[:space:]]*-[[:space:]]+kind:[[:space:]]*/, "", kind)
      kind = clean(kind)
      next
    }
    in_config && kind == "defaults" && /^[[:space:]]+domain:[[:space:]]*/ {
      domain = $0
      sub(/^[[:space:]]+domain:[[:space:]]*/, "", domain)
      domain = clean(domain)
      next
    }
    in_config && kind == "defaults" && /^[[:space:]]+keys:[[:space:]]*$/ {
      in_keys = 1
      next
    }
    in_config && kind == "defaults" && in_keys && /^      [^#].*:[[:space:]]*\{/ {
      line = substr($0, 7)
      key = line
      sub(/:[[:space:]]*\{.*/, "", key)
      key = clean(key)
      label = key
      if (line ~ /ui:[[:space:]]*"/) {
        label = line
        sub(/^.*ui:[[:space:]]*"/, "", label)
        sub(/".*$/, "", label)
      }
      print "preference\t" label "\t" domain "/" key "\tfalse"
      next
    }
    in_config && in_keys && !/^      / { in_keys = 0 }
    in_config && kind == "file" && /^[[:space:]]+path:[[:space:]]*/ {
      path = $0
      sub(/^[[:space:]]+path:[[:space:]]*/, "", path)
      path = clean(path)
      next
    }
    in_config && kind == "file" && /^[[:space:]]+format:[[:space:]]*/ {
      format = $0
      sub(/^[[:space:]]+format:[[:space:]]*/, "", format)
      format = clean(format)
      next
    }
    in_config && kind == "file" && /^[[:space:]]+export:[[:space:]]*/ {
      export = $0
      sub(/^[[:space:]]+export:[[:space:]]*/, "", export)
      export = clean(export)
      next
    }
    in_config && kind == "command" && /^[[:space:]]+name:[[:space:]]*/ {
      name = $0
      sub(/^[[:space:]]+name:[[:space:]]*/, "", name)
      name = clean(name)
      next
    }
    END { if (in_config) flush_entry() }
  ' "$recipe"
}

fallback_recipe_catalog() {
  local recipe_root recipe id name bundle_id capture_kinds
  local recipe_paths="$TEMP_DIR/app-state-recipe-paths"
  local catalog_lines="$TEMP_DIR/app-state-fallback-catalog.ndjson"

  : >"$recipe_paths"
  : >"$catalog_lines"
  for recipe_root in "${app_state_recipe_paths[@]}"; do
    if [[ -d "$recipe_root" ]]; then
      find "$recipe_root" -type f \( -name '*.yaml' -o -name '*.yml' \) -print 2>/dev/null
    elif [[ -f "$recipe_root" ]]; then
      printf '%s\n' "$recipe_root"
    fi
  done | sort -u >"$recipe_paths"

  while IFS= read -r recipe; do
    [[ -n "$recipe" ]] || continue
    id="$(recipe_scalar id "$recipe")"
    name="$(recipe_scalar name "$recipe")"
    bundle_id="$(recipe_scalar bundle_id "$recipe")"
    if [[ -z "$id" || -z "$name" || -z "$bundle_id" ]]; then
      continue
    fi
    capture_kinds="$(recipe_capture_kinds "$recipe" | jq -Rsc 'split("\n") | map(select(length > 0)) | unique')"
    jq -cn \
      --arg id "$id" \
      --arg name "$name" \
      --arg bundleId "$bundle_id" \
      --argjson captureKinds "$capture_kinds" \
      '{
        id: $id,
        name: $name,
        bundleId: $bundleId,
        installed: false,
        capturable: ($captureKinds | length > 0),
        captureKinds: $captureKinds,
        exportableSettings: [],
        managedPaths: [],
        manualSteps: []
      }' >>"$catalog_lines"
  done <"$recipe_paths"

  if [[ -s "$catalog_lines" ]]; then
    jq -sc '{version: 1, applications: (sort_by(.name | ascii_downcase))}' "$catalog_lines"
  else
    printf '{"version":1,"applications":[]}\n'
  fi
}

valid_local_ai_status() {
  jq -e '
    type == "object" and
    .schemaVersion == 1 and
    (.health | IN("healthy", "degraded", "unavailable")) and
    (.summary | type == "string" and length > 0) and
    (.ds4Checkout | type == "object") and
    (.ds4Checkout.state | IN("ready", "missing", "invalid", "unavailable")) and
    (.ds4Checkout.path | type == "string" and length > 0) and
    (.piDs4Checkout | type == "object") and
    (.piDs4Checkout.state | IN("ready", "missing", "invalid", "unavailable")) and
    (.piDs4Checkout.path | type == "string" and length > 0) and
    (.extension | type == "object") and
    (.extension.state | IN("linked", "missing", "mislinked", "unavailable")) and
    (.extension.path | type == "string" and length > 0) and
    (.runtime | type == "object") and
    (.runtime.state | IN("built", "notBuilt", "unavailable")) and
    (.runtime.path | type == "string" and length > 0) and
    (.model | type == "object") and
    (.model.state | IN("present", "missing", "unavailable")) and
    (.model.name | type == "string" and length > 0) and
    (.model.path | type == "string" and length > 0) and
    (.server | type == "object") and
    (.server.state | IN("running", "stopped", "unavailable")) and
    (.configuration | type == "object") and
    (.configuration.state | IN("current", "drifted", "unavailable")) and
    (
      (.configuration.state == "current" and .configuration.driftCount == 0) or
      (.configuration.state == "drifted" and
        (.configuration.driftCount | type == "number" and . > 0 and floor == .)) or
      (.configuration.state == "unavailable" and .configuration.driftCount == null)
    ) and
    (.remediation | type == "array") and
    all(.remediation[]; type == "string" and length > 0) and
    (if .health == "healthy" then (.remediation | length) == 0 else (.remediation | length) > 0 end) and
    (
      if .health == "healthy" then
        .ds4Checkout.state == "ready" and
        .piDs4Checkout.state == "ready" and
        .extension.state == "linked" and
        .runtime.state == "built" and
        .model.state == "present" and
        (.server.state | IN("running", "stopped")) and
        .configuration.state == "current"
      elif .health == "unavailable" then
        any([
          .ds4Checkout.state,
          .piDs4Checkout.state,
          .extension.state,
          .runtime.state,
          .model.state,
          .server.state,
          .configuration.state
        ][]; . == "unavailable")
      else
        all([
          .ds4Checkout.state,
          .piDs4Checkout.state,
          .extension.state,
          .runtime.state,
          .model.state,
          .server.state,
          .configuration.state
        ][]; . != "unavailable")
      end
    )
  ' >/dev/null 2>&1 <<<"$1"
}

unavailable_local_ai() {
  local remediation="$1"
  local ds4_dir pi_ds4_dir pi_agent_dir model_name model_path
  ds4_dir="${DS4_RUNTIME_DIR:-$HOME/src/ai/ds4}"
  pi_ds4_dir="${PI_DS4_DIR:-$HOME/src/ai/pi-ds4}"
  pi_agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  model_name="${LOCAL_AI_MODEL_NAME:-DeepSeek V4 Flash Q2}"
  model_path="${LOCAL_AI_MODEL_PATH:-$ds4_dir/ds4flash.gguf}"

  jq -n \
    --arg remediation "$remediation" \
    --arg ds4Path "$ds4_dir" \
    --arg piDs4Path "$pi_ds4_dir" \
    --arg extensionPath "${LOCAL_AI_EXTENSION_PATH:-$pi_agent_dir/extensions/pi-ds4}" \
    --arg runtimePath "$ds4_dir/ds4-server" \
    --arg modelName "$model_name" \
    --arg modelPath "$model_path" \
    '{
      schemaVersion: 1,
      health: "unavailable",
      summary: "Local AI status is unavailable",
      ds4Checkout: {state: "unavailable", path: $ds4Path},
      piDs4Checkout: {state: "unavailable", path: $piDs4Path},
      extension: {state: "unavailable", path: $extensionPath},
      runtime: {state: "unavailable", path: $runtimePath},
      model: {state: "unavailable", name: $modelName, path: $modelPath},
      server: {state: "unavailable"},
      configuration: {state: "unavailable", driftCount: null},
      remediation: [$remediation]
    }'
}

run_bounded_local_ai_status() {
  local output_file="$1"
  local error_file="$2"
  shift 2
  local timeout_seconds="${NIX_ME_LOCAL_AI_TIMEOUT_SECONDS:-5}"
  local max_ticks ticks pid status

  if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || ((timeout_seconds > 30)); then
    timeout_seconds=5
  fi
  max_ticks=$((timeout_seconds * 10))
  ticks=0

  "$@" >"$output_file" 2>"$error_file" &
  pid=$!
  while kill -0 "$pid" >/dev/null 2>&1; do
    if ((ticks >= max_ticks)); then
      kill "$pid" >/dev/null 2>&1 || true
      sleep 0.1
      kill -9 "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
      return 124
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done

  wait "$pid"
  status=$?
  return "$status"
}

if [[ "$REQUESTED_ENDPOINT" != "local-ai" ]]; then
app_state_warnings='[]'

add_app_state_warning() {
  local message="$1"
  app_state_warnings="$(jq -c --arg message "$message" '. + [$message]' <<<"$app_state_warnings")"
}

valid_app_state_status() {
  jq -e '
    type == "object" and
    has("schemaVersion") and
    has("engine") and
    has("configuredRecipeCount") and
    has("driftCount") and
    has("manualResidueCount") and
    has("lastApply") and
    has("verification") and
    has("warnings") and
    .schemaVersion == 1 and
    (.engine | type == "object" and has("available") and has("version")) and
    (.engine.available | type == "boolean") and
    (.engine.version == null or (.engine.version | type == "string" and length > 0)) and
    (.configuredRecipeCount == null or (.configuredRecipeCount | type == "number" and . >= 0 and floor == .)) and
    (.driftCount == null or (.driftCount | type == "number" and . >= 0 and floor == .)) and
    (.manualResidueCount == null or (.manualResidueCount | type == "number" and . >= 0 and floor == .)) and
    (.lastApply | type == "object" and has("status") and has("time") and has("message")) and
    (.lastApply.status == null or (.lastApply.status | IN("succeeded", "partial", "declined", "failed"))) and
    (.lastApply.time == null or (.lastApply.time |
      type == "string" and
      test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"))) and
    (.lastApply.message == null or (.lastApply.message | type == "string")) and
    (.verification | type == "object" and has("verifiedRecipeCount") and has("unverifiedRecipeCount")) and
    (.verification.verifiedRecipeCount == null or (.verification.verifiedRecipeCount | type == "number" and . >= 0 and floor == .)) and
    (.verification.unverifiedRecipeCount == null or (.verification.unverifiedRecipeCount | type == "number" and . >= 0 and floor == .)) and
    (.warnings | type == "array") and
    all(.warnings[]; type == "string" and length > 0)
  ' >/dev/null 2>&1 <<<"$1"
}

unknown_app_state() {
  jq -cn \
    --argjson engineAvailable "$app_state_engine_available" \
    --argjson engineVersion "$app_state_engine_version" \
    --argjson warnings "$app_state_warnings" \
    '{
      schemaVersion: 1,
      engine: {available: $engineAvailable, version: $engineVersion},
      configuredRecipeCount: null,
      driftCount: null,
      manualResidueCount: null,
      lastApply: {status: null, time: null, message: null},
      verification: {verifiedRecipeCount: null, unverifiedRecipeCount: null},
      warnings: $warnings
    }'
}

app_state_engine=''
app_state_engine_available=false
app_state_engine_version='null'

if [[ -n "${NIX_ME_APP_STATE_ENGINE_VERSION:-}" ]]; then
  app_state_engine_available=true
  app_state_engine_version="$(jq -cn --arg version "$NIX_ME_APP_STATE_ENGINE_VERSION" '$version')"
fi

if [[ -n "${NIX_ME_APP_STATE_ENGINE+x}" ]]; then
  engine_candidate="$NIX_ME_APP_STATE_ENGINE"
  if [[ "$engine_candidate" == */* ]]; then
    [[ -x "$engine_candidate" ]] && app_state_engine="$engine_candidate"
  elif command_exists "$engine_candidate"; then
    app_state_engine="$(command -v "$engine_candidate")"
  fi
elif command_exists nix-me-apps; then
  app_state_engine="$(command -v nix-me-apps)"
elif [[ -x "$CONFIG_DIR/packages/app-state/engine/target/debug/nix-me-apps" ]]; then
  app_state_engine="$CONFIG_DIR/packages/app-state/engine/target/debug/nix-me-apps"
