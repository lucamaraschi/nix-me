    engine_version_text="$("$app_state_engine" --version 2>/dev/null | head -1 || true)"
    engine_version_text="${engine_version_text#nix-me-apps }"
    if [[ -n "$engine_version_text" ]]; then
      app_state_engine_version="$(jq -cn --arg version "$engine_version_text" '$version')"
    else
      add_app_state_warning "The app-state engine version could not be discovered"
    fi
  fi
elif [[ "$app_state_engine_available" != "true" ]]; then
  add_app_state_warning "The app-state engine is unavailable"
fi

desired_manifest='null'
if [[ -n "${NIX_ME_DESIRED_MANIFEST:-}" ]]; then
  if desired_manifest="$(jq -c . "$NIX_ME_DESIRED_MANIFEST" 2>/dev/null)"; then
    :
  else
    desired_manifest='null'
    add_warning "The desired manifest fixture is not valid JSON"
  fi
elif [[ -f "$CONFIG_DIR/flake.nix" ]] && command_exists nix; then
  source_revision=''
  if command_exists git && source_revision="$(git -C "$CONFIG_DIR" rev-parse --verify HEAD 2>/dev/null)"; then
    if [[ -n "$(git -C "$CONFIG_DIR" status --porcelain --untracked-files=normal 2>/dev/null)" ]]; then
      source_revision="${source_revision}-dirty"
    fi
  else
    source_revision=''
  fi
  # Host selection and disposable-VM overrides are intentionally environment-driven.
  if ! desired_manifest="$(NIX_ME_SOURCE_REVISION="$source_revision" nix eval --impure --json "path:$CONFIG_DIR#darwinConfigurations.$HOST_NAME.config.nixMe.manifest" 2>"$TEMP_DIR/nix-eval.err")"; then
    desired_manifest='null'
    nix_error="$(tail -1 "$TEMP_DIR/nix-eval.err" 2>/dev/null || true)"
    add_warning "Could not evaluate the desired configuration${nix_error:+: $nix_error}"
  elif ! jq -e . >/dev/null 2>&1 <<<"$desired_manifest"; then
    desired_manifest='null'
    add_warning "Nix returned an invalid desired manifest"
  fi
else
  add_warning "The desired configuration is unavailable"
fi

recipe_path_list="${NIX_ME_APP_STATE_RECIPES:-$CONFIG_DIR/packages/app-state/recipes}"
IFS=':' read -r -a app_state_recipe_paths <<<"$recipe_path_list"
app_state_values_paths=()
if [[ -n "${NIX_ME_APP_STATE_VALUES:-}" ]]; then
  IFS=':' read -r -a app_state_values_paths <<<"$NIX_ME_APP_STATE_VALUES"
elif [[ "$desired_manifest" != "null" ]] && jq -e '.appState.valueFiles | type == "array"' >/dev/null 2>&1 <<<"$desired_manifest"; then
  while IFS= read -r values_path; do
    [[ -n "$values_path" ]] && app_state_values_paths+=("$values_path")
  done < <(jq -r '.appState.valueFiles[]' <<<"$desired_manifest")
else
  app_state_values_paths+=("$CONFIG_DIR/packages/app-state/values/rectangle.yaml")
  app_state_values_paths+=("$CONFIG_DIR/config/app-state/shared")
  app_state_values_paths+=("$CONFIG_DIR/config/app-state/machines/$HOST_NAME")
