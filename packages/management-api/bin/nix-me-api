drift_count='null'
manual_residue_count='null'
if [[ "$app_state_plan" != "null" ]]; then
  if jq -e '
    type == "object" and
    .version == 1 and
    (.summary | type == "object") and
    (.summary.drift | type == "number" and . >= 0 and floor == .) and
    (.summary.manual | type == "number" and . >= 0 and floor == .)
  ' >/dev/null 2>&1 <<<"$app_state_plan"; then
    drift_count="$(jq -c '.summary.drift' <<<"$app_state_plan")"
    manual_residue_count="$(jq -c '.summary.manual' <<<"$app_state_plan")"
    if jq -e '
      (.apps | type == "array") and
      all(.apps[]; (.id | type == "string" and length > 0)) and
      (
        (.apps | length) > 0 or
        ([.summary.writes, .summary.adds, .summary.dels, .summary.files, .summary.materialize, .summary.drift, .summary.manual] | all(. == 0))
      )
    ' >/dev/null 2>&1 <<<"$app_state_plan"; then
      configured_recipe_count="$(jq -c '.apps | length' <<<"$app_state_plan")"
      if [[ "$registry_unverified_ids" != "null" ]]; then
        unverified_recipe_count="$(jq -c --argjson unverified "$registry_unverified_ids" '
          [.apps[].id | select(. as $id | $unverified | index($id))] | length
        ' <<<"$app_state_plan")"
        verified_recipe_count=$((configured_recipe_count - unverified_recipe_count))
      fi
    fi
  else
    add_app_state_warning "The app-state plan status does not match version 1"
  fi
fi

if [[ "$app_state_registry" != "null" && "$configured_recipe_count" == "null" ]]; then
  add_app_state_warning "Configured app-state recipes are unknown without engine status"
