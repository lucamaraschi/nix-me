#!/bin/bash

# Machine-readable backend for native and third-party nix-me clients.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
CONFIG_DIR="${NIX_ME_CONFIG_DIR:-$REPO_DIR}"
HOST_NAME="${NIX_ME_HOSTNAME:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"
APPLIED_MANIFEST="${NIX_ME_APPLIED_MANIFEST:-/etc/nix-me/manifest.json}"
API_VERSION=1

# GUI apps do not inherit the interactive shell PATH.
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-$(id -un)}/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

if ! command -v jq >/dev/null 2>&1; then
  printf '{"schemaVersion":1,"error":{"code":"missing_dependency","message":"jq is required by the nix-me API"}}\n'
  exit 69
fi

TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/nix-me-api.XXXXXX")"
trap 'rm -rf "$TEMP_DIR"' EXIT

warnings='[]'

add_warning() {
  local message="$1"
  warnings="$(jq -c --arg message "$message" '. + [$message]' <<<"$warnings")"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

app_state_warnings='[]'

add_app_state_warning() {
  local message="$1"
  app_state_warnings="$(jq -c --arg message "$message" '. + [$message]' <<<"$app_state_warnings")"
}

app_state_engine=''
app_state_engine_available=false
app_state_engine_version='null'

if [[ -n "${NIX_ME_APP_STATE_ENGINE_VERSION:-}" ]]; then
  app_state_engine_available=true
  app_state_engine_version="$(jq -cn --arg version "$NIX_ME_APP_STATE_ENGINE_VERSION" '$version')"
fi

if [[ -n "${NIX_ME_APP_STATE_ENGINE+x}" ]]; then
  engine_candidate="$NIX_ME_APP_STATE_ENGINE"
  if [[ "$engine_candidate" == */* ]]; then
    [[ -x "$engine_candidate" ]] && app_state_engine="$engine_candidate"
  elif command_exists "$engine_candidate"; then
    app_state_engine="$(command -v "$engine_candidate")"
  fi
elif command_exists nix-me-apps; then
  app_state_engine="$(command -v nix-me-apps)"
elif [[ -x "$CONFIG_DIR/packages/app-state/engine/target/debug/nix-me-apps" ]]; then
  app_state_engine="$CONFIG_DIR/packages/app-state/engine/target/debug/nix-me-apps"
fi

if [[ -n "$app_state_engine" ]]; then
  app_state_engine_available=true
  if [[ "$app_state_engine_version" == "null" ]]; then
    engine_version_text="$($app_state_engine --version 2>/dev/null | head -1 || true)"
    engine_version_text="${engine_version_text#nix-me-apps }"
    if [[ -n "$engine_version_text" ]]; then
      app_state_engine_version="$(jq -cn --arg version "$engine_version_text" '$version')"
    else
      add_app_state_warning "The app-state engine version could not be discovered"
    fi
  fi
elif [[ "$app_state_engine_available" != "true" ]]; then
  add_app_state_warning "The app-state engine is unavailable"
fi

recipe_path_list="${NIX_ME_APP_STATE_RECIPES:-$CONFIG_DIR/packages/app-state/recipes}"
values_path_list="${NIX_ME_APP_STATE_VALUES:-$CONFIG_DIR/packages/app-state/values}"
IFS=':' read -r -a app_state_recipe_paths <<<"$recipe_path_list"
IFS=':' read -r -a app_state_values_paths <<<"$values_path_list"

app_state_registry='null'
if [[ -n "${NIX_ME_APP_STATE_REGISTRY:-}" ]]; then
  if [[ -r "$NIX_ME_APP_STATE_REGISTRY" ]] && app_state_registry="$(jq -c . "$NIX_ME_APP_STATE_REGISTRY" 2>/dev/null)"; then
    :
  else
    app_state_registry='null'
    add_app_state_warning "The app-state registry status is malformed or unreadable"
  fi
elif [[ -n "$app_state_engine" ]]; then
  registry_args=(registry validate --json)
  for recipe_path in "${app_state_recipe_paths[@]}"; do
    [[ -n "$recipe_path" ]] && registry_args+=(--recipe "$recipe_path")
  done
  if "$app_state_engine" "${registry_args[@]}" >"$TEMP_DIR/app-state-registry.json" 2>"$TEMP_DIR/app-state-registry.err"; then
    app_state_registry="$(jq -c . "$TEMP_DIR/app-state-registry.json" 2>/dev/null || printf null)"
  else
    registry_error="$(tail -1 "$TEMP_DIR/app-state-registry.err" 2>/dev/null || true)"
    add_app_state_warning "The app-state recipe registry is unavailable${registry_error:+: $registry_error}"
  fi
else
  add_app_state_warning "The app-state recipe registry is unavailable"
fi

configured_recipe_count='null'
verified_recipe_count='null'
unverified_recipe_count='null'
if [[ "$app_state_registry" != "null" ]]; then
  if jq -e '
    type == "object" and
    .version == 1 and
    .valid == true and
    (.recipes | type == "number" and . >= 0 and floor == .) and
    (.ids | type == "array") and
    (all(.ids[]; type == "string")) and
    (.unverified | type == "array") and
    (all(.unverified[]; type == "string")) and
    (.recipes as $recipes |
      (.ids | length) == $recipes and
      (.unverified | length) <= $recipes)
  ' >/dev/null 2>&1 <<<"$app_state_registry"; then
    configured_recipe_count="$(jq -c '.recipes' <<<"$app_state_registry")"
    unverified_recipe_count="$(jq -c '.unverified | length' <<<"$app_state_registry")"
    verified_recipe_count="$((configured_recipe_count - unverified_recipe_count))"
  else
    add_app_state_warning "The app-state registry status does not match version 1"
  fi
fi

app_state_plan='null'
if [[ -n "${NIX_ME_APP_STATE_PLAN:-}" ]]; then
  if [[ -r "$NIX_ME_APP_STATE_PLAN" ]] && app_state_plan="$(jq -c . "$NIX_ME_APP_STATE_PLAN" 2>/dev/null)"; then
    :
  else
    app_state_plan='null'
    add_app_state_warning "The app-state plan status is malformed or unreadable"
  fi
elif [[ -n "$app_state_engine" ]]; then
  plan_args=(diff --json --no-exec --skip-missing)
  for recipe_path in "${app_state_recipe_paths[@]}"; do
    [[ -n "$recipe_path" ]] && plan_args+=(--recipe "$recipe_path")
  done
  value_file_count=0
  for values_path in "${app_state_values_paths[@]}"; do
    [[ -z "$values_path" ]] && continue
    if [[ -d "$values_path" ]]; then
      while IFS= read -r values_file; do
        plan_args+=(--values "$values_file")
        value_file_count=$((value_file_count + 1))
      done < <(find "$values_path" -type f \( -name '*.yaml' -o -name '*.yml' \) -print 2>/dev/null | sort)
    else
      plan_args+=(--values "$values_path")
      value_file_count=$((value_file_count + 1))
    fi
  done

  if (( value_file_count == 0 )); then
    add_app_state_warning "The app-state plan is unavailable because no values files are configured"
  else
    "$app_state_engine" "${plan_args[@]}" >"$TEMP_DIR/app-state-plan.json" 2>"$TEMP_DIR/app-state-plan.err" || true
    if app_state_plan="$(jq -c . "$TEMP_DIR/app-state-plan.json" 2>/dev/null)"; then
      :
    else
      app_state_plan='null'
      plan_error="$(tail -1 "$TEMP_DIR/app-state-plan.err" 2>/dev/null || true)"
      add_app_state_warning "The app-state plan is unavailable${plan_error:+: $plan_error}"
    fi
  fi
else
  add_app_state_warning "The app-state plan is unavailable"
fi

drift_count='null'
manual_residue_count='null'
if [[ "$app_state_plan" != "null" ]]; then
  if jq -e '
    type == "object" and
    .version == 1 and
    (.summary | type == "object") and
    (.summary.drift | type == "number" and . >= 0 and floor == .) and
    (.summary.manual | type == "number" and . >= 0 and floor == .)
  ' >/dev/null 2>&1 <<<"$app_state_plan"; then
    drift_count="$(jq -c '.summary.drift' <<<"$app_state_plan")"
    manual_residue_count="$(jq -c '.summary.manual' <<<"$app_state_plan")"
  else
    add_app_state_warning "The app-state plan status does not match version 1"
  fi
fi

if [[ -n "${NIX_ME_APP_STATE_STATE:-}" ]]; then
  app_state_file="$NIX_ME_APP_STATE_STATE"
elif [[ -n "${NIX_ME_STATE_DIR:-}" ]]; then
  app_state_file="$NIX_ME_STATE_DIR/apps.json"
elif [[ -n "${XDG_STATE_HOME:-}" ]]; then
  app_state_file="$XDG_STATE_HOME/nix-me/apps.json"
else
  app_state_file="$HOME/.local/state/nix-me/apps.json"
fi

persisted_app_state='null'
persisted_state_time='null'
if [[ -r "$app_state_file" ]]; then
  if persisted_app_state="$(jq -c . "$app_state_file" 2>/dev/null)" && jq -e '
    type == "object" and
    .version == 1 and
    (.updated_at | type == "string") and
    (.updated_at == "" or (.updated_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"))) and
    (.apps | type == "object")
  ' >/dev/null 2>&1 <<<"$persisted_app_state"; then
    if [[ -n "$(jq -r '.updated_at' <<<"$persisted_app_state")" ]]; then
      persisted_state_time="$(jq -c '.updated_at' <<<"$persisted_app_state")"
    fi
  else
    persisted_app_state='null'
    add_app_state_warning "The persisted app-state status is malformed"
  fi
else
  add_app_state_warning "The persisted app-state status is unavailable"
fi

last_apply_status='null'
last_apply_time="$persisted_state_time"
last_apply_message='null'
if [[ -n "${NIX_ME_APP_STATE_LAST_APPLY:-}" ]]; then
  last_apply_file="$NIX_ME_APP_STATE_LAST_APPLY"
else
  last_apply_file="$(dirname "$app_state_file")/last-apply.json"
fi

last_apply='null'
if [[ -r "$last_apply_file" ]]; then
  if last_apply="$(jq -c . "$last_apply_file" 2>/dev/null)" && jq -e '
    type == "object" and
    (.status | IN("succeeded", "partial", "failed")) and
    (.time == null or (.time |
      type == "string" and
      test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"))) and
    (.message == null or (.message | type == "string"))
  ' >/dev/null 2>&1 <<<"$last_apply"; then
    last_apply_status="$(jq -c '.status' <<<"$last_apply")"
    last_apply_time="$(jq -c '.time' <<<"$last_apply")"
    last_apply_message="$(jq -c '.message' <<<"$last_apply")"
  else
    last_apply='null'
    add_app_state_warning "The last app-state apply status is malformed"
  fi
else
  add_app_state_warning "The last app-state apply status is unavailable"
fi

app_state="$(jq -n \
  --argjson engineAvailable "$app_state_engine_available" \
  --argjson engineVersion "$app_state_engine_version" \
  --argjson configuredRecipeCount "$configured_recipe_count" \
  --argjson driftCount "$drift_count" \
  --argjson manualResidueCount "$manual_residue_count" \
  --argjson lastApplyStatus "$last_apply_status" \
  --argjson lastApplyTime "$last_apply_time" \
  --argjson lastApplyMessage "$last_apply_message" \
  --argjson verifiedRecipeCount "$verified_recipe_count" \
  --argjson unverifiedRecipeCount "$unverified_recipe_count" \
  --argjson warnings "$app_state_warnings" \
  '{
    schemaVersion: 1,
    engine: {available: $engineAvailable, version: $engineVersion},
    configuredRecipeCount: $configuredRecipeCount,
    driftCount: $driftCount,
    manualResidueCount: $manualResidueCount,
    lastApply: {
      status: $lastApplyStatus,
      time: $lastApplyTime,
      message: $lastApplyMessage
    },
    verification: {
      verifiedRecipeCount: $verifiedRecipeCount,
      unverifiedRecipeCount: $unverifiedRecipeCount
    },
    warnings: $warnings
  }')"

git_state() {
  local directory="$1"

  if ! git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    jq -n '{repository: false, branch: null, revision: null, dirty: false, upstream: null, ahead: 0, behind: 0, remoteState: "notRepository"}'
    return
  fi

  local branch revision upstream dirty ahead behind counts remote_state
  branch="$(git -C "$directory" branch --show-current 2>/dev/null || true)"
  revision="$(git -C "$directory" rev-parse HEAD 2>/dev/null || true)"
  upstream="$(git -C "$directory" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
  dirty=false
  ahead=0
  behind=0

  if [[ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]]; then
    dirty=true
  fi

  if [[ -n "$upstream" ]]; then
    counts="$(git -C "$directory" rev-list --left-right --count "$upstream...HEAD" 2>/dev/null || true)"
    if [[ "$counts" =~ ^[[:space:]]*([0-9]+)[[:space:]]+([0-9]+)[[:space:]]*$ ]]; then
      behind="${BASH_REMATCH[1]}"
      ahead="${BASH_REMATCH[2]}"
    fi
  fi

  if [[ -z "$upstream" ]]; then
    remote_state="noUpstream"
  elif (( ahead > 0 && behind > 0 )); then
    remote_state="diverged"
  elif (( ahead > 0 )); then
    remote_state="ahead"
  elif (( behind > 0 )); then
    remote_state="behind"
  else
    remote_state="upToDate"
  fi

  jq -n \
    --arg branch "$branch" \
    --arg revision "$revision" \
    --arg upstream "$upstream" \
    --arg remoteState "$remote_state" \
    --argjson dirty "$dirty" \
    --argjson ahead "$ahead" \
    --argjson behind "$behind" \
    '{
      repository: true,
      branch: (if $branch == "" then null else $branch end),
      revision: (if $revision == "" then null else $revision end),
      dirty: $dirty,
      upstream: (if $upstream == "" then null else $upstream end),
      ahead: $ahead,
      behind: $behind,
      remoteState: $remoteState
    }'
}

desired_manifest='null'
if [[ -n "${NIX_ME_DESIRED_MANIFEST:-}" ]]; then
  if desired_manifest="$(jq -c . "$NIX_ME_DESIRED_MANIFEST" 2>/dev/null)"; then
    :
  else
    desired_manifest='null'
    add_warning "The desired manifest fixture is not valid JSON"
  fi
elif [[ -f "$CONFIG_DIR/flake.nix" ]] && command_exists nix; then
  if ! desired_manifest="$(nix eval --json "$CONFIG_DIR#darwinConfigurations.$HOST_NAME.config.nixMe.manifest" 2>"$TEMP_DIR/nix-eval.err")"; then
    desired_manifest='null'
    nix_error="$(tail -1 "$TEMP_DIR/nix-eval.err" 2>/dev/null || true)"
    add_warning "Could not evaluate the desired configuration${nix_error:+: $nix_error}"
  elif ! jq -e . >/dev/null 2>&1 <<<"$desired_manifest"; then
    desired_manifest='null'
    add_warning "Nix returned an invalid desired manifest"
  fi
else
  add_warning "The desired configuration is unavailable"
fi

applied_manifest='null'
if [[ -r "$APPLIED_MANIFEST" ]]; then
  if applied_manifest="$(jq -c . "$APPLIED_MANIFEST" 2>/dev/null)"; then
    :
  else
    applied_manifest='null'
    add_warning "The applied manifest is not valid JSON"
  fi
fi

apply_state="unknown"
if [[ "$desired_manifest" != "null" && "$applied_manifest" != "null" ]]; then
  desired_fingerprint="$(jq -cS '{host, software, projects, contentHash: .source.contentHash, lockHash: .source.lockHash}' <<<"$desired_manifest")"
  applied_fingerprint="$(jq -cS '{host, software, projects, contentHash: .source.contentHash, lockHash: .source.lockHash}' <<<"$applied_manifest")"
  if [[ "$desired_fingerprint" == "$applied_fingerprint" ]]; then
    apply_state="current"
  else
    apply_state="pending"
  fi
fi

config_git='null'
if [[ -d "$CONFIG_DIR" ]] && command_exists git; then
  config_git="$(git_state "$CONFIG_DIR")"
fi

brew_formulae='[]'
brew_casks='[]'
brew_updates='[]'
mas_updates='[]'
nix_updates='[]'
if command_exists brew; then
  brew_formulae="$(brew list --formula --versions 2>/dev/null | jq -Rsc '
    split("\n") | map(select(length > 0) | split(" ") | {name: .[0], versions: .[1:]})
  ')"
  brew_casks="$(brew list --cask --versions 2>/dev/null | jq -Rsc '
    split("\n") | map(select(length > 0) | split(" ") | {name: .[0], versions: .[1:]})
  ')"

  if [[ "${NIX_ME_SKIP_UPDATES:-0}" != "1" ]]; then
    if brew_outdated="$(brew outdated --json=v2 2>"$TEMP_DIR/brew-outdated.err")"; then
      brew_updates="$(jq -c '
        ([.formulae[]? | {
          name,
          kind: "formula",
          installedVersions: (.installed_versions // []),
          availableVersion: (.current_version // null)
        }]) +
        ([.casks[]? | {
          name,
          kind: "cask",
          installedVersions: (.installed_versions // []),
          availableVersion: (.current_version // null)
        }])
      ' <<<"$brew_outdated" 2>/dev/null || printf '[]')"
    else
      add_warning "Homebrew update information is unavailable"
    fi
  fi
fi

if command_exists mas && [[ "${NIX_ME_SKIP_UPDATES:-0}" != "1" ]]; then
  if mas_outdated="$(mas outdated 2>"$TEMP_DIR/mas-outdated.err")"; then
    mas_updates="$(jq -Rsc '
      split("\n")
      | map(
          select(length > 0)
          | capture("^\\s*(?<storeId>[0-9]+)\\s+(?<name>.+\\S)\\s+\\((?<installed>\\S+)\\s*->\\s*(?<available>[^)]+\\S)\\)$")
          | {
              name,
              kind: "mas",
              installedVersions: [.installed],
              availableVersion: .available,
              storeId: (.storeId | tonumber)
            }
        )
    ' <<<"$mas_outdated" 2>/dev/null || printf '[]')"
  else
    add_warning "Mac App Store update information is unavailable"
  fi
fi

if command_exists nix && [[ -r "$CONFIG_DIR/flake.lock" && "${NIX_ME_SKIP_UPDATES:-0}" != "1" ]]; then
  candidate_lock="$TEMP_DIR/candidate-flake.lock"
  if nix flake update \
    --flake "$CONFIG_DIR" \
    --output-lock-file "$candidate_lock" \
    >"$TEMP_DIR/nix-update.out" \
    2>"$TEMP_DIR/nix-update.err"; then
    nix_updates="$(jq -cn \
      --slurpfile current "$CONFIG_DIR/flake.lock" \
      --slurpfile candidate "$candidate_lock" '
        [
          $candidate[0].nodes.root.inputs
          | to_entries[]
          | . as $input
          | (if ($input.value | type) == "array" then $input.value[-1] else $input.value end) as $candidateNode
          | ($current[0].nodes.root.inputs[$input.key] // null) as $currentValue
          | (if ($currentValue | type) == "array" then $currentValue[-1] else $currentValue end) as $currentNode
          | ($current[0].nodes[$currentNode].locked.rev // $current[0].nodes[$currentNode].locked.narHash // "") as $installed
          | ($candidate[0].nodes[$candidateNode].locked.rev // $candidate[0].nodes[$candidateNode].locked.narHash // "") as $available
          | select($installed != $available)
          | {
              name: $input.key,
              kind: "nixFlake",
              installedVersions: [$installed[0:7]],
              availableVersion: $available[0:7]
            }
        ]
      ')"
  else
    add_warning "Nix flake update information is unavailable"
  fi
fi

projects='[]'
if [[ "$desired_manifest" != "null" ]]; then
  while IFS= read -r project; do
    [[ -z "$project" ]] && continue

    raw_path="$(jq -r '.path' <<<"$project")"
    case "$raw_path" in
      /*) absolute_path="$raw_path" ;;
      \~/*) absolute_path="$HOME/${raw_path#\~/}" ;;
      *) absolute_path="$HOME/$raw_path" ;;
    esac

    present=false
    is_git=false
    project_status="missing"
    project_git='null'

    if [[ -d "$absolute_path" ]]; then
      present=true
      if command_exists git && git -C "$absolute_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        is_git=true
        project_git="$(git_state "$absolute_path")"
        project_dirty="$(jq -r '.dirty' <<<"$project_git")"
        remote_state="$(jq -r '.remoteState' <<<"$project_git")"
        if [[ "$project_dirty" == "true" ]]; then
          project_status="changes"
        elif [[ "$remote_state" == "upToDate" ]]; then
          project_status="current"
        else
          project_status="$remote_state"
        fi
      else
        project_status="notRepository"
      fi
    fi

    project="$(jq -c \
      --arg absolutePath "$absolute_path" \
      --arg status "$project_status" \
      --argjson present "$present" \
      --argjson isGitRepository "$is_git" \
      --argjson git "$project_git" \
      '. + {
        absolutePath: $absolutePath,
        present: $present,
        isGitRepository: $isGitRepository,
        status: $status,
        git: $git
      }' <<<"$project")"
    projects="$(jq -c --argjson project "$project" '. + [$project]' <<<"$projects")"
  done < <(jq -c '.projects[]?' <<<"$desired_manifest")
fi

nix_version='null'
if command_exists nix; then
  nix_version="$(nix --version 2>/dev/null | jq -Rsc 'rtrimstr("\n")')"
fi

generation='null'
if [[ -L /nix/var/nix/profiles/system ]]; then
  generation_target="$(readlink /nix/var/nix/profiles/system 2>/dev/null || true)"
  if [[ "$generation_target" =~ system-([0-9]+)-link$ ]]; then
    generation="${BASH_REMATCH[1]}"
  fi
fi

generated_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
snapshot="$(jq -n \
  --argjson schemaVersion "$API_VERSION" \
  --arg generatedAt "$generated_at" \
  --arg hostname "$HOST_NAME" \
  --arg username "${USER:-$(id -un)}" \
  --arg configurationPath "$CONFIG_DIR" \
  --arg appliedManifestPath "$APPLIED_MANIFEST" \
  --arg applyState "$apply_state" \
  --argjson generation "$generation" \
  --argjson desired "$desired_manifest" \
  --argjson applied "$applied_manifest" \
  --argjson configGit "$config_git" \
  --argjson nixAvailable "$(command_exists nix && printf true || printf false)" \
  --argjson darwinAvailable "$(command_exists darwin-rebuild && printf true || printf false)" \
  --argjson homebrewAvailable "$(command_exists brew && printf true || printf false)" \
  --argjson nixVersion "$nix_version" \
  --argjson brewFormulae "$brew_formulae" \
  --argjson brewCasks "$brew_casks" \
  --argjson brewUpdates "$brew_updates" \
  --argjson masUpdates "$mas_updates" \
  --argjson nixUpdates "$nix_updates" \
  --argjson projects "$projects" \
  --argjson appState "$app_state" \
  --argjson warnings "$warnings" \
  '{
    schemaVersion: $schemaVersion,
    generatedAt: $generatedAt,
    host: ($desired.host // {hostname: $hostname, machineName: $hostname, machineType: null, username: $username}),
    configuration: {
      path: $configurationPath,
      exists: ($desired != null),
      appliedManifestPath: $appliedManifestPath,
      applyState: $applyState,
      generation: $generation,
      git: $configGit,
      desiredSource: ($desired.source // null),
      appliedSource: ($applied.source // null)
    },
    health: {
      nix: {available: $nixAvailable, version: $nixVersion},
      nixDarwin: {available: $darwinAvailable},
      homebrew: {available: $homebrewAvailable}
    },
    inventory: {
      desired: ($desired.software // {nixPackages: [], nixPackageDetails: [], homebrew: {formulae: [], casks: [], masApps: {}}}),
      applied: ($applied.software // {nixPackages: [], nixPackageDetails: [], homebrew: {formulae: [], casks: [], masApps: {}}}),
      installed: {homebrew: {formulae: $brewFormulae, casks: $brewCasks}}
    },
    updates: {homebrew: $brewUpdates, macAppStore: $masUpdates, nixFlake: $nixUpdates},
    projects: $projects,
    appState: $appState,
    warnings: $warnings
  }')"

case "${1:-snapshot}" in
  snapshot)
    jq . <<<"$snapshot"
    ;;
  status)
    jq '{schemaVersion, generatedAt, host, configuration, health, warnings}' <<<"$snapshot"
    ;;
  inventory)
    jq '{schemaVersion, generatedAt, host, inventory, warnings}' <<<"$snapshot"
    ;;
  updates)
    jq '{schemaVersion, generatedAt, host, updates, warnings}' <<<"$snapshot"
    ;;
  projects)
    jq '{schemaVersion, generatedAt, host, projects, warnings}' <<<"$snapshot"
    ;;
  app-state)
    jq '{schemaVersion, generatedAt, host, appState, warnings: (.warnings + .appState.warnings)}' <<<"$snapshot"
    ;;
  manifest)
    if [[ "$desired_manifest" == "null" ]]; then
      jq -n --argjson schemaVersion "$API_VERSION" --argjson warnings "$warnings" \
        '{schemaVersion: $schemaVersion, error: {code: "manifest_unavailable", message: "The desired manifest could not be evaluated"}, warnings: $warnings}'
      exit 1
    fi
    jq . <<<"$desired_manifest"
    ;;
  *)
    jq -n --arg command "$1" \
      '{schemaVersion: 1, error: {code: "unknown_endpoint", message: ("Unknown API endpoint: " + $command)}}'
    exit 64
    ;;
esac
