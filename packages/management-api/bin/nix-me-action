#!/bin/bash

# Validated mutation backend for the native nix-me application.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
CONFIG_DIR="${NIX_ME_CONFIG_DIR:-$REPO_DIR}"
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-$(id -un)}/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

if ! command -v jq >/dev/null 2>&1; then
  printf '{"schemaVersion":1,"error":{"code":"missing_dependency","message":"jq is required by nix-me actions"}}\n'
  exit 69
fi

action="${1:-}"

run_apply() {
  local host_name current_user make_path log_file message succeeded
  host_name="${NIX_ME_HOSTNAME:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"
  current_user="${NIX_ME_USERNAME:-${USER:-$(id -un)}}"
  make_path="$(command -v make)"

  if [[ ! -f "$CONFIG_DIR/flake.nix" || ! -f "$CONFIG_DIR/Makefile" ]]; then
    jq -n '{schemaVersion: 1, action: "apply", success: false, message: "The nix-me configuration or Makefile is missing"}'
    return
  fi

  if [[ ! "$host_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || ! "$current_user" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    jq -n '{schemaVersion: 1, action: "apply", success: false, message: "The host or username failed validation"}'
    return
  fi

  if [[ "${NIX_ME_ACTION_DRY_RUN:-0}" == "1" ]]; then
    jq -n \
      --arg host "$host_name" \
      --arg username "$current_user" \
      '{schemaVersion: 1, action: "apply", success: true, message: ("Would apply configuration for " + $host + " as " + $username)}'
    return
  fi

  log_file="$(mktemp "${TMPDIR:-/tmp}/nix-me-apply.XXXXXX")"
  succeeded=true
  if ! /usr/bin/osascript \
    -e 'on run argv' \
    -e 'set makePath to item 1 of argv' \
    -e 'set configPath to item 2 of argv' \
    -e 'set hostName to item 3 of argv' \
    -e 'set userName to item 4 of argv' \
    -e 'set commandText to "env PATH=/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin " & quoted form of makePath & " -C " & quoted form of configPath & " SKIP_BREW=1 FLAKE_DIR=" & quoted form of configPath & " HOSTNAME=" & quoted form of hostName & " USERNAME=" & quoted form of userName & " switch-fast"' \
    -e 'with timeout of 86400 seconds' \
    -e 'do shell script commandText with administrator privileges' \
    -e 'end timeout' \
    -e 'end run' \
    -- "$make_path" "$CONFIG_DIR" "$host_name" "$current_user" >"$log_file" 2>&1; then
    succeeded=false
  fi

  message="$(tail -40 "$log_file" 2>/dev/null || true)"
  rm -f -- "$log_file"
  jq -n \
    --argjson success "$succeeded" \
    --arg message "${message:-Configuration applied successfully}" \
    '{schemaVersion: 1, action: "apply", success: $success, message: $message}'
}

run_sync_projects() {
  local host_name home_dir sync_script log_file message succeeded
  host_name="${NIX_ME_HOSTNAME:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"
  home_dir="${HOME:-}"
  sync_script="$CONFIG_DIR/tools/installation/sync-projects.sh"

  if [[ ! "$host_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || -z "$home_dir" ]]; then
    jq -n '{schemaVersion: 1, action: "sync-projects", success: false, message: "The host or home directory failed validation"}'
    return
  fi

  if [[ ! -x "$sync_script" || ! -f "$CONFIG_DIR/flake.nix" ]]; then
    jq -n '{schemaVersion: 1, action: "sync-projects", success: false, message: "The project sync script or flake is missing"}'
    return
  fi

  if [[ "${NIX_ME_ACTION_DRY_RUN:-0}" == "1" ]]; then
    jq -n --arg host "$host_name" \
      '{schemaVersion: 1, action: "sync-projects", success: true, message: ("Would sync projects for " + $host)}'
    return
  fi

  log_file="$(mktemp "${TMPDIR:-/tmp}/nix-me-projects.XXXXXX")"
  succeeded=true
  if ! "$sync_script" --flake-dir "$CONFIG_DIR" --hostname "$host_name" --home "$home_dir" >"$log_file" 2>&1; then
    succeeded=false
  fi
  message="$(tail -40 "$log_file" 2>/dev/null || true)"
  rm -f -- "$log_file"
  jq -n \
    --argjson success "$succeeded" \
    --arg message "${message:-Projects synchronized successfully}" \
    '{schemaVersion: 1, action: "sync-projects", success: $success, message: $message}'
}

if [[ "$action" == "apply" ]]; then
  run_apply
  exit 0
fi

if [[ "$action" == "sync-projects" ]]; then
  run_sync_projects
  exit 0
fi

if [[ "$action" != "update" ]]; then
  jq -n --arg action "$action" \
    '{schemaVersion: 1, error: {code: "unknown_action", message: ("Unknown action: " + $action)}}'
  exit 64
fi

payload="$(cat)"
if ! jq -e '
  (.items | type == "array") and
  (.items | length > 0) and
  all(.items[];
    (.kind | IN("formula", "cask", "mas", "nixFlake")) and
    (.name | type == "string") and
    (if .kind == "mas"
      then ((.name | test("^[^\\r\\n]+$")) and (.storeId | (type == "number" and . > 0 and . == floor)))
      else (.name | test("^[A-Za-z0-9][A-Za-z0-9@+._/-]*$"))
    end)
  )
' >/dev/null 2>&1 <<<"$payload"; then
  jq -n '{schemaVersion: 1, error: {code: "invalid_request", message: "Update items failed validation"}}'
  exit 65
fi

TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/nix-me-action.XXXXXX")"
trap 'rm -rf "$TEMP_DIR"' EXIT

results='[]'
requires_apply=false

append_results() {
  local items="$1"
  local succeeded="$2"
  local message="$3"
  local group_results
  group_results="$(jq -c \
    --argjson succeeded "$succeeded" \
    --arg message "$message" \
    'map(. + {success: $succeeded, message: $message})' <<<"$items")"
  results="$(jq -c --argjson additions "$group_results" '. + $additions' <<<"$results")"
}

run_brew_group() {
  local kind="$1"
  local flag="$2"
  local items names=() log_file message succeeded
  items="$(jq -c --arg kind "$kind" '[.items[] | select(.kind == $kind)]' <<<"$payload")"
  [[ "$(jq 'length' <<<"$items")" -eq 0 ]] && return

  while IFS= read -r name; do
    names+=("$name")
  done < <(jq -r '.[].name' <<<"$items")

  log_file="$TEMP_DIR/brew-$kind.log"
  succeeded=true
  if [[ "${NIX_ME_ACTION_DRY_RUN:-0}" == "1" ]]; then
    printf 'Would update %s: %s\n' "$kind" "${names[*]}" >"$log_file"
  elif ! brew upgrade "$flag" "${names[@]}" >"$log_file" 2>&1; then
    succeeded=false
  fi
  message="$(tail -20 "$log_file" 2>/dev/null || true)"
  append_results "$items" "$succeeded" "${message:-Update completed}"
}

run_nix_updates() {
  local items item name safe_name log_file message succeeded
  items="$(jq -c '[.items[] | select(.kind == "nixFlake")]' <<<"$payload")"
  [[ "$(jq 'length' <<<"$items")" -eq 0 ]] && return

  while IFS= read -r item; do
    name="$(jq -r '.name' <<<"$item")"
    safe_name="${name//\//_}"
    log_file="$TEMP_DIR/nix-$safe_name.log"
    succeeded=true
    if [[ "${NIX_ME_ACTION_DRY_RUN:-0}" == "1" ]]; then
      printf 'Would update Nix input: %s\n' "$name" >"$log_file"
    elif ! nix flake update "$name" --flake "$CONFIG_DIR" >"$log_file" 2>&1; then
      succeeded=false
    fi
    if [[ "$succeeded" == "true" ]]; then
      requires_apply=true
    fi
    message="$(tail -20 "$log_file" 2>/dev/null || true)"
    append_results "[$item]" "$succeeded" "${message:-Flake input updated}"
  done < <(jq -c '.[]' <<<"$items")
}

run_mas_updates() {
  local items ids=() mas_path log_file message succeeded
  items="$(jq -c '[.items[] | select(.kind == "mas")]' <<<"$payload")"
  [[ "$(jq 'length' <<<"$items")" -eq 0 ]] && return

  while IFS= read -r store_id; do
    ids+=("$store_id")
  done < <(jq -r '.[].storeId' <<<"$items")

  log_file="$TEMP_DIR/mas.log"
  succeeded=true
  if [[ "${NIX_ME_ACTION_DRY_RUN:-0}" == "1" ]]; then
    printf 'Would update Mac App Store IDs: %s\n' "${ids[*]}" >"$log_file"
  elif ! mas_path="$(command -v mas)"; then
    append_results "$items" false "mas is not installed"
    return
  elif ! /usr/bin/osascript \
    -e 'on run argv' \
    -e 'set commandText to quoted form of (item 1 of argv) & " update"' \
    -e 'repeat with itemIndex from 2 to count of argv' \
    -e 'set commandText to commandText & " " & quoted form of (item itemIndex of argv)' \
    -e 'end repeat' \
    -e 'do shell script commandText with administrator privileges' \
    -e 'end run' \
    -- "$mas_path" "${ids[@]}" >"$log_file" 2>&1; then
    succeeded=false
  fi
  message="$(tail -20 "$log_file" 2>/dev/null || true)"
  append_results "$items" "$succeeded" "${message:-Mac App Store update completed}"
}

run_nix_updates
run_brew_group formula --formula
run_brew_group cask --cask
run_mas_updates

success="$(jq 'all(.[]; .success)' <<<"$results")"
jq -n \
  --argjson success "$success" \
  --argjson requiresApply "$requires_apply" \
  --argjson results "$results" \
  '{schemaVersion: 1, action: "update", success: $success, requiresApply: $requiresApply, results: $results}'
