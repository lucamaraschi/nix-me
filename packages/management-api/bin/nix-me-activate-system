#!/bin/bash

set -euo pipefail

PATH="/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

die() {
  printf 'nix-me activation: %s\n' "$*" >&2
  exit 1
}

if [[ "$EUID" -ne 0 ]]; then
  die "administrator privileges are required"
fi

if [[ "$#" -ne 2 ]]; then
  die "usage: nix-me-activate-system SYSTEM_PATH USERNAME"
fi

system_path="$1"
username="$2"
rebuild_path="$system_path/sw/bin/darwin-rebuild"
lock_dir="/var/run/nix-me-activation.lock"
sudoers_file="/etc/sudoers.d/nix-me-activation-$$"
sudoers_staging="${sudoers_file}.tmp"
watchdog_pid=""
lock_acquired=false

case "$system_path" in
  /nix/store/*) ;;
  *) die "the system path must be in /nix/store" ;;
esac

if [[ ! "$username" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  die "the username failed validation"
fi

user_id="$(/usr/bin/id -u "$username" 2>/dev/null || true)"
if [[ -z "$user_id" || "$user_id" == "0" ]]; then
  die "the activation user is unavailable or invalid"
fi

if [[ ! -x "$rebuild_path" ]]; then
  die "the built system does not contain darwin-rebuild"
fi

nix_env_path=""
for candidate in \
  /nix/var/nix/profiles/default/bin/nix-env \
  /run/current-system/sw/bin/nix-env \
  "$system_path/sw/bin/nix-env"; do
  if [[ -x "$candidate" ]]; then
    nix_env_path="$candidate"
    break
  fi
done
if [[ -z "$nix_env_path" ]]; then
  die "nix-env is unavailable"
fi

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP

  if [[ -n "$watchdog_pid" ]]; then
    kill "$watchdog_pid" >/dev/null 2>&1 || true
    wait "$watchdog_pid" 2>/dev/null || true
  fi

  rm -f -- "$sudoers_staging" "$sudoers_file"
  # NOPASSWD commands can create a sudo timestamp. Remove it with the rule.
  /usr/bin/sudo -u "$username" /usr/bin/sudo -K >/dev/null 2>&1 || true

  if [[ "$lock_acquired" == "true" ]]; then
    rm -f -- "$lock_dir/pid"
    rmdir "$lock_dir" >/dev/null 2>&1 || true
  fi

  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

if ! mkdir "$lock_dir" 2>/dev/null; then
  lock_owner="$(cat "$lock_dir/pid" 2>/dev/null || true)"
  if [[ "$lock_owner" =~ ^[0-9]+$ ]] && kill -0 "$lock_owner" 2>/dev/null; then
    die "another system activation is already running"
  fi
  rm -f -- "$lock_dir/pid"
  rmdir "$lock_dir" 2>/dev/null || die "could not clear a stale activation lock"
  mkdir "$lock_dir" || die "could not acquire the activation lock"
fi
lock_acquired=true
printf '%s\n' "$$" >"$lock_dir/pid"

parent_pid="$$"
(
  trap - EXIT INT TERM HUP
  while kill -0 "$parent_pid" 2>/dev/null; do
    sleep 1
  done
  rm -f -- "$sudoers_staging" "$sudoers_file"
  /usr/bin/sudo -u "$username" /usr/bin/sudo -K >/dev/null 2>&1 || true
  rm -f -- "$lock_dir/pid"
  rmdir "$lock_dir" >/dev/null 2>&1 || true
) &
watchdog_pid=$!

if [[ ! -d /etc/sudoers.d ]]; then
  die "/etc/sudoers.d is unavailable"
fi

umask 077
printf '%s ALL=(ALL) NOPASSWD: SETENV: ALL\n' "$username" >"$sudoers_staging"
chmod 0440 "$sudoers_staging"
/usr/sbin/visudo -cf "$sudoers_staging" >/dev/null || die "the temporary sudo policy is invalid"
mv "$sudoers_staging" "$sudoers_file"
/usr/sbin/visudo -cf /etc/sudoers >/dev/null || die "the active sudo configuration is invalid"

# Activation runs without a terminal. Homebrew casks and mas invoke sudo again,
# so authorize only the selected login user for this activation window.
if ! /usr/bin/sudo -u "$username" /usr/bin/sudo -n /usr/bin/true; then
  die "the temporary package-installer authorization is unavailable"
fi

export HOME=/var/root
export USER=root
export LOGNAME=root
export SUDO_USER="$username"
export USERNAME="$username"

printf 'Activating the built system as %s...\n' "$username"
"$nix_env_path" -p /nix/var/nix/profiles/system --set "$system_path"
"$rebuild_path" activate
