#!/bin/bash

set -euo pipefail

PATH="/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

die() {
  printf 'nix-me activation: %s\n' "$*" >&2
  exit 1
}

if [[ "$EUID" -ne 0 ]]; then
  die "administrator privileges are required"
fi

if [[ "$#" -ne 2 ]]; then
  die "usage: nix-me-activate-system SYSTEM_PATH USERNAME"
fi

system_path="$1"
username="$2"
rebuild_path="$system_path/sw/bin/darwin-rebuild"
mas_installer="$system_path/etc/nix-me/install-mas-apps"
manifest_path="$system_path/etc/nix-me/manifest.json"
lock_file="/var/run/nix-me-activation.lock"
lock_timeout_seconds=1800
sudoers_file="/etc/sudoers.d/nix-me-activation-$$"
sudoers_staging="${sudoers_file}.tmp"
watchdog_pid=""
lock_fd_open=false

case "$system_path" in
  /nix/store/*) ;;
  *) die "the system path must be in /nix/store" ;;
esac

if [[ ! "$username" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  die "the username failed validation"
fi

user_id="$(/usr/bin/id -u "$username" 2>/dev/null || true)"
if [[ -z "$user_id" || "$user_id" == "0" ]]; then
  die "the activation user is unavailable or invalid"
fi

if [[ ! -x "$rebuild_path" ]]; then
  die "the built system does not contain darwin-rebuild"
fi

nix_env_path=""
for candidate in \
  /nix/var/nix/profiles/default/bin/nix-env \
  /run/current-system/sw/bin/nix-env \
  "$system_path/sw/bin/nix-env"; do
  if [[ -x "$candidate" ]]; then
    nix_env_path="$candidate"
    break
  fi
done
if [[ -z "$nix_env_path" ]]; then
  die "nix-env is unavailable"
fi

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP

  if [[ -n "$watchdog_pid" ]]; then
    kill "$watchdog_pid" >/dev/null 2>&1 || true
    wait "$watchdog_pid" 2>/dev/null || true
  fi

  rm -f -- "$sudoers_staging" "$sudoers_file"
  # NOPASSWD commands can create a sudo timestamp. Remove it with the rule.
  /usr/bin/sudo -u "$username" /usr/bin/sudo -K >/dev/null 2>&1 || true

  if [[ "$lock_fd_open" == "true" ]]; then
    exec 9>&-
  fi

  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

activation_owner_is_running() {
  local owner="$1"
  local command
  [[ "$owner" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$owner" 2>/dev/null || return 1
  command="$(ps -p "$owner" -o command= 2>/dev/null || true)"
  [[ "$command" == *"nix-me-activate-system"* ]]
}

migrate_legacy_lock() {
  local started=$SECONDS
  local announced=false
  local empty_checks=0
  local owner

  while [[ -d "$lock_file" ]]; do
    if ((SECONDS - started >= lock_timeout_seconds)); then
      die "timed out waiting for the previous activation lock"
    fi
    owner="$(cat "$lock_file/pid" 2>/dev/null || true)"
    if activation_owner_is_running "$owner"; then
      if [[ "$announced" != "true" ]]; then
        printf 'Another Nix Me activation is running (pid %s); waiting for it to finish...\n' \
          "$owner"
        announced=true
      fi
      sleep 2
      continue
    fi

    # Give an older runner time to write its PID after creating the directory.
    if [[ -z "$owner" && "$empty_checks" -lt 2 ]]; then
      empty_checks=$((empty_checks + 1))
      sleep 1
      continue
    fi

    rm -f -- "$lock_file/pid"
    if rmdir "$lock_file" 2>/dev/null; then
      printf 'Recovered a stale Nix Me activation lock.\n'
    else
      sleep 1
    fi
  done
}

migrate_legacy_lock
if ! exec 9>"$lock_file"; then
  die "could not open the system activation lock"
fi
lock_fd_open=true
if ! /usr/bin/lockf -t 0 9; then
  printf 'Another Nix Me activation is running; waiting for it to finish...\n'
  /usr/bin/lockf -t "$lock_timeout_seconds" 9 || \
    die "timed out waiting for the active system activation"
fi

parent_pid="$$"
(
  trap - EXIT INT TERM HUP
  # The watchdog must not inherit the activation lock from its parent.
  exec 9>&-
  while kill -0 "$parent_pid" 2>/dev/null; do
    sleep 1
  done
  rm -f -- "$sudoers_staging" "$sudoers_file"
  /usr/bin/sudo -u "$username" /usr/bin/sudo -K >/dev/null 2>&1 || true
) &
watchdog_pid=$!

if [[ ! -d /etc/sudoers.d ]]; then
  die "/etc/sudoers.d is unavailable"
fi

umask 077
printf '%s ALL=(ALL) NOPASSWD: SETENV: ALL\n' "$username" >"$sudoers_staging"
chmod 0440 "$sudoers_staging"
/usr/sbin/visudo -cf "$sudoers_staging" >/dev/null || die "the temporary sudo policy is invalid"
mv "$sudoers_staging" "$sudoers_file"
/usr/sbin/visudo -cf /etc/sudoers >/dev/null || die "the active sudo configuration is invalid"

# Activation runs without a terminal. Homebrew casks and mas invoke sudo again,
# so authorize only the selected login user for this activation window.
if ! /usr/bin/sudo -u "$username" /usr/bin/sudo -n /usr/bin/true; then
  die "the temporary package-installer authorization is unavailable"
fi

export HOME=/var/root
export USER=root
export LOGNAME=root
export SUDO_USER="$username"
export USERNAME="$username"

printf 'Activating the built system as %s...\n' "$username"
"$nix_env_path" -p /nix/var/nix/profiles/system --set "$system_path"
"$rebuild_path" activate

if [[ -x "$mas_installer" && -f "$manifest_path" ]]; then
  user_home="$(/usr/bin/dscl . -read "/Users/$username" NFSHomeDirectory 2>/dev/null \
    | /usr/bin/awk '{ print $2 }')"
  if [[ -z "$user_home" || ! -d "$user_home" ]]; then
    die "could not resolve the activation user's home directory"
  fi
  printf 'Installing configured Mac App Store applications as %s...\n' "$username"
  /bin/launchctl asuser "$user_id" \
    /usr/bin/sudo -H -u "$username" \
    /usr/bin/env \
      HOME="$user_home" \
      USER="$username" \
      LOGNAME="$username" \
      "$mas_installer" "$manifest_path"
fi
