{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucamaraschi/nix-me/packages/management-api/schema/snapshot-v1.schema.json",
  "title": "nix-me management snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "host",
    "configuration",
    "inventory",
    "updates",
    "projects",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "host": { "type": "object" },
    "configuration": { "type": "object" },
    "inventory": { "type": "object" },
    "updates": { "type": "object" },
    "projects": { "type": "array" },
    "appState": { "$ref": "#/$defs/appState" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nullableCount": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "appState": {
      "type": "object",
      "required": [
        "schemaVersion",
        "engine",
        "configuredRecipeCount",
        "driftCount",
        "manualResidueCount",
        "lastApply",
        "verification",
        "warnings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "engine": {
          "type": "object",
          "required": ["available", "version"],
          "properties": {
            "available": { "type": "boolean" },
            "version": {
              "type": ["string", "null"],
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "configuredRecipeCount": { "$ref": "#/$defs/nullableCount" },
        "driftCount": { "$ref": "#/$defs/nullableCount" },
        "manualResidueCount": { "$ref": "#/$defs/nullableCount" },
        "lastApply": {
          "type": "object",
          "required": ["status", "time", "message"],
          "properties": {
            "status": {
              "type": ["string", "null"],
              "enum": ["succeeded", "partial", "declined", "failed", null]
            },
            "time": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "message": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "verification": {
          "type": "object",
          "required": ["verifiedRecipeCount", "unverifiedRecipeCount"],
          "properties": {
            "verifiedRecipeCount": { "$ref": "#/$defs/nullableCount" },
            "unverifiedRecipeCount": { "$ref": "#/$defs/nullableCount" }
          },
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  }
}
