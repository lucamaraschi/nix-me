{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucamaraschi/nix-me/packages/management-api/schema/snapshot-v1.schema.json",
  "title": "nix-me management snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "host",
    "configuration",
    "inventory",
    "updates",
    "projects",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "host": { "type": "object" },
    "configuration": { "type": "object" },
    "inventory": { "type": "object" },
    "updates": { "type": "object" },
    "projects": { "type": "array" },
    "appState": { "$ref": "#/$defs/appState" },
    "localAI": { "$ref": "#/$defs/localAI" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nullableCount": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "appState": {
      "type": "object",
      "required": [
        "schemaVersion",
        "engine",
        "configuredRecipeCount",
        "driftCount",
        "manualResidueCount",
        "lastApply",
        "verification",
        "warnings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "engine": {
          "type": "object",
          "required": ["available", "version"],
          "properties": {
            "available": { "type": "boolean" },
            "version": {
              "type": ["string", "null"],
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "configuredRecipeCount": { "$ref": "#/$defs/nullableCount" },
        "driftCount": { "$ref": "#/$defs/nullableCount" },
        "manualResidueCount": { "$ref": "#/$defs/nullableCount" },
        "lastApply": {
          "type": "object",
          "required": ["status", "time", "message"],
          "properties": {
            "status": {
              "type": ["string", "null"],
              "enum": ["succeeded", "partial", "declined", "failed", null]
            },
            "time": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "message": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "verification": {
          "type": "object",
          "required": ["verifiedRecipeCount", "unverifiedRecipeCount"],
          "properties": {
            "verifiedRecipeCount": { "$ref": "#/$defs/nullableCount" },
            "unverifiedRecipeCount": { "$ref": "#/$defs/nullableCount" }
          },
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "localAI": {
      "type": "object",
      "required": [
        "schemaVersion",
        "health",
        "summary",
        "ds4Checkout",
        "piDs4Checkout",
        "extension",
        "runtime",
        "model",
        "server",
        "configuration",
        "remediation"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "health": {
          "type": "string",
          "enum": ["healthy", "degraded", "unavailable"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "ds4Checkout": { "$ref": "#/$defs/localAICheckout" },
        "piDs4Checkout": { "$ref": "#/$defs/localAICheckout" },
        "extension": {
          "type": "object",
          "required": ["state", "path"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["linked", "missing", "mislinked", "unavailable"]
            },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "runtime": {
          "type": "object",
          "required": ["state", "path"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["built", "notBuilt", "unavailable"]
            },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "model": {
          "type": "object",
          "required": ["state", "name", "path"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["present", "missing", "unavailable"]
            },
            "name": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "server": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["running", "stopped", "unavailable"]
            }
          },
          "additionalProperties": true
        },
        "configuration": {
          "type": "object",
          "required": ["state", "driftCount"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["current", "drifted", "unavailable"]
            },
            "driftCount": { "$ref": "#/$defs/nullableCount" }
          },
          "additionalProperties": true
        },
        "remediation": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"health": {"const": "healthy"}}},
          "then": {"properties": {"remediation": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"health": {"enum": ["degraded", "unavailable"]}}},
          "then": {"properties": {"remediation": {"minItems": 1}}}
        }
      ],
      "additionalProperties": true
    },
    "localAICheckout": {
      "type": "object",
      "required": ["state", "path"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "missing", "invalid", "unavailable"]
        },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
