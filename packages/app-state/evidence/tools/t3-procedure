#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVIDENCE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$EVIDENCE_DIR/../../.." && pwd)"
PROCEDURES_DIR="$EVIDENCE_DIR/procedures"
RUNS_DIR="$EVIDENCE_DIR/runs"
PROCEDURE_VALIDATOR="$SCRIPT_DIR/validate-procedure.jq"
EVIDENCE_TOOL="$SCRIPT_DIR/evidence-tool"

die() {
  printf 't3-procedure: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  t3-procedure validate [PROCEDURE ...]
  t3-procedure run PROCEDURE_ID --output RUN_DIR [--engine PATH]
                   [--environment-id ID] [--harness-revision SHA]
  t3-procedure collect-draft RUN_DIR [OUTPUT]
  t3-procedure finalize RUN_DIR OUTPUT

The run command requires an interactive terminal. It has no unattended
acceptance flag. collect-draft always emits lifecycle=draft; only finalize can
emit lifecycle=final, and finalize never stamps a recipe.
EOF
  exit 2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_file() {
  [ -f "$1" ] || die "file not found: $1"
}

utc_now() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

sha256_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    shasum -a 256 | awk '{print $1}'
  fi
}

file_bytes() {
  wc -c < "$1" | tr -d '[:space:]'
}

normalized_recipe() {
  awk '
    BEGIN { found = 0; in_verified = 0 }
    /^verified:[[:space:]]*/ {
      if (found) exit 3
      print "verified: null"
      found = 1
      in_verified = 1
      next
    }
    in_verified && /^[^[:space:]]/ { in_verified = 0 }
    in_verified { next }
    { print }
    END { if (!found) exit 4 }
  ' "$1"
}

recipe_sha256() {
  normalized_recipe "$1" | sha256_stdin
}

repository_relative() {
  case "$1" in
    "$REPO_ROOT"/*) printf '%s\n' "${1#"$REPO_ROOT/"}" ;;
    *) die "path is outside the repository: $1" ;;
  esac
}

validate_procedure() {
  local procedure="$1"
  local errors

  require_file "$procedure"
  jq empty "$procedure" 2>/dev/null || die "$procedure is not valid JSON"
  errors="$(jq -r -f "$PROCEDURE_VALIDATOR" "$procedure")" \
    || die "procedure validator failed for $procedure"
  if [ "$errors" != "[]" ]; then
    printf 't3-procedure: procedure validation failed: %s\n' "$procedure" >&2
    printf '%s\n' "$errors" | jq -r '.[] | "  - " + .' >&2
    return 1
  fi

  require_file "$REPO_ROOT/$(jq -r '.recipe.path' "$procedure")"
  require_file "$REPO_ROOT/$(jq -r '.recipe.values_path' "$procedure")"
}

procedure_path() {
  local requested="$1"
  local candidate id match=""

  case "$requested" in
    *[!a-z0-9-]*|'') die "procedure id must be kebab-case: $requested" ;;
  esac
  while IFS= read -r candidate; do
    id="$(jq -r '.id // empty' "$candidate" 2>/dev/null || true)"
    if [ "$id" = "$requested" ]; then
      [ -z "$match" ] || die "duplicate procedure id: $requested"
      match="$candidate"
    fi
  done < <(find "$PROCEDURES_DIR" -type f -name '*.v*.json' -print | LC_ALL=C sort)
  [ -n "$match" ] || die "unknown procedure id: $requested"
  printf '%s\n' "$match"
}

validate_all() {
  local procedure count=0

  jq empty "$PROCEDURES_DIR/t3-procedure.schema.json"
  jq empty "$EVIDENCE_DIR/t3-run-record.schema.json"
  if [ "$#" -gt 0 ]; then
    for procedure in "$@"; do
      validate_procedure "$procedure"
      count=$((count + 1))
    done
  else
    while IFS= read -r procedure; do
      validate_procedure "$procedure"
      count=$((count + 1))
    done < <(find "$PROCEDURES_DIR" -type f -name '*.v*.json' -print | LC_ALL=C sort)
  fi
  [ "$count" -gt 0 ] || die "no T3 procedures found"
  printf 'Validated %d T3 procedure(s).\n' "$count"
}

canonical_run_dir() {
  local requested="$1"
  local parent base

  mkdir -p "$RUNS_DIR"
  case "$requested" in
    /*) ;;
    *) requested="$PWD/$requested" ;;
  esac
  parent="$(cd "$(dirname "$requested")" && pwd -P)"
  base="$(basename "$requested")"
  case "$base" in
    *[!A-Za-z0-9._-]*|'') die "run directory name contains unsupported characters: $base" ;;
  esac
  [ "$parent" = "$RUNS_DIR" ] \
    || die "run directories must be direct children of $RUNS_DIR"
  printf '%s/%s\n' "$parent" "$base"
}

media_type_for_path() {
  case "$1" in
    *.png|*.PNG) printf 'image/png\n' ;;
    *.jpg|*.JPG|*.jpeg|*.JPEG) printf 'image/jpeg\n' ;;
    *.mov|*.MOV) printf 'video/quicktime\n' ;;
    *.mp4|*.MP4) printf 'video/mp4\n' ;;
    *) return 1 ;;
  esac
}

extension_for_media_type() {
  case "$1" in
    image/png) printf 'png\n' ;;
    image/jpeg) printf 'jpg\n' ;;
    video/quicktime) printf 'mov\n' ;;
    video/mp4) printf 'mp4\n' ;;
    *) return 1 ;;
  esac
}

run_engine_phase() {
  local phase="$1"
  local mode="$2"
  local engine="$3"
  local recipe="$4"
  local values="$5"
  local recipe_id="$6"
  local run_dir="$7"
  local started finished status

  started="$(utc_now)"
  set +e
  if [ "$mode" = "apply" ]; then
    "$engine" apply --recipe "$recipe" --values "$values" --only "$recipe_id" --yes --json \
      >"$run_dir/$phase.log" 2> >(tee "$run_dir/$phase.stderr.log" >&2)
  else
    "$engine" diff --recipe "$recipe" --values "$values" --only "$recipe_id" --json \
      >"$run_dir/$phase.log" 2> >(tee "$run_dir/$phase.stderr.log" >&2)
  fi
  status=$?
  set -e
  finished="$(utc_now)"

  jq -n \
    --arg mode "$mode" \
    --arg output "$phase.log" \
    --arg output_sha256 "$(sha256_file "$run_dir/$phase.log")" \
    --argjson output_bytes "$(file_bytes "$run_dir/$phase.log")" \
    --arg stderr "$phase.stderr.log" \
    --arg stderr_sha256 "$(sha256_file "$run_dir/$phase.stderr.log")" \
    --argjson stderr_bytes "$(file_bytes "$run_dir/$phase.stderr.log")" \
    --arg started_at "$started" \
    --arg finished_at "$finished" \
    --argjson exit_code "$status" \
    '{mode:$mode, output:$output, output_sha256:$output_sha256, output_bytes:$output_bytes, stderr:$stderr, stderr_sha256:$stderr_sha256, stderr_bytes:$stderr_bytes, exit_code:$exit_code, started_at:$started_at, finished_at:$finished_at}' \
    > "$run_dir/$phase-execution.json"
}

operator_prompt() {
  local procedure="$1"
  local run_dir="$2"
  local challenge identity observation source_path media_type extension destination confirmation observed_at
  local accepted=false
  local artifact_json='null'

  [ -t 0 ] && [ -t 1 ] \
    || die "operator confirmation requires an interactive terminal; there is no unattended acceptance mode"

  printf '\nOperator procedure:\n'
  jq -r '.operator.instructions | to_entries[] | "  \(.key + 1). \(.value)"' "$procedure"
  printf '\nAcceptance criteria:\n'
  jq -r '.operator.acceptance[] | "  - " + .' "$procedure"
  printf '\nThe harness cannot inspect the screen. A human operator must perform and observe these steps.\n'

  printf 'Operator name or handle: ' > /dev/tty
  IFS= read -r identity < /dev/tty
  printf 'Describe exactly what you observed (one line): ' > /dev/tty
  IFS= read -r observation < /dev/tty
  printf 'Path to the screenshot or video captured in this VM (blank records failure): ' > /dev/tty
  IFS= read -r source_path < /dev/tty

  media_type=""
  if [ -n "$source_path" ] && [ -f "$source_path" ] && [ -s "$source_path" ]; then
    media_type="$(media_type_for_path "$source_path" 2>/dev/null || true)"
    if [ -n "$media_type" ] && jq -e --arg media "$media_type" \
      '.operator.artifact.allowed_media_types | index($media) != null' "$procedure" >/dev/null; then
      extension="$(extension_for_media_type "$media_type")"
      destination="$run_dir/visible-artifact.$extension"
      cp "$source_path" "$destination"
      artifact_json="$(jq -n \
        --arg path "$(basename "$destination")" \
        --arg media_type "$media_type" \
        --arg sha256 "$(sha256_file "$destination")" \
        --argjson bytes "$(file_bytes "$destination")" \
        '{path:$path, media_type:$media_type, sha256:$sha256, bytes:$bytes}')"
    else
      printf 'Artifact type is not permitted by this procedure; the observation will fail.\n' >&2
    fi
  else
    printf 'No non-empty artifact was supplied; the observation will fail.\n' >&2
  fi

  challenge="$(openssl rand -hex 3 2>/dev/null || printf '%06x' "$$")"
  challenge="$(printf '%s' "$challenge" | tr '[:lower:]' '[:upper:]')"
  printf 'After personally checking every criterion, type exactly "PASS %s". Any other response records failure: ' "$challenge" > /dev/tty
  IFS= read -r confirmation < /dev/tty
  observed_at="$(utc_now)"

  if [ -n "$identity" ] && [ -n "$observation" ] && [ "$artifact_json" != "null" ] \
    && [ "$confirmation" = "PASS $challenge" ]; then
    accepted=true
  fi

  {
    printf 'procedure_id=%s\n' "$(jq -r '.id' "$procedure")"
    printf 'procedure_version=%s\n' "$(jq -r '.version' "$procedure")"
    printf 'operator=%s\n' "$identity"
    printf 'observed_at=%s\n' "$observed_at"
    printf 'challenge=%s\n' "$challenge"
    printf 'confirmation=%s\n' "$confirmation"
    printf 'accepted=%s\n' "$accepted"
    printf 'observation=%s\n' "$observation"
  } > "$run_dir/operator-observation.txt"

  jq -n \
    --arg identity "$identity" \
    --arg observed_at "$observed_at" \
    --arg challenge "$challenge" \
    --arg confirmation "$confirmation" \
    --arg observation "$observation" \
    --arg report "operator-observation.txt" \
    --arg report_sha256 "$(sha256_file "$run_dir/operator-observation.txt")" \
    --argjson report_bytes "$(file_bytes "$run_dir/operator-observation.txt")" \
    --argjson attested "$accepted" \
    --argjson artifact "$artifact_json" \
    '{attested:$attested, identity:$identity, observed_at:$observed_at, challenge:$challenge, confirmation:$confirmation, observation:$observation, report:$report, report_sha256:$report_sha256, report_bytes:$report_bytes, artifact:$artifact}' \
    > "$run_dir/operator.json"
}

run_procedure() {
  local requested="$1"
  shift
  local output="" engine="" environment_id="" harness_revision=""
  local procedure recipe values recipe_id app_path bundle_id actual_bundle_id
  local app_version app_build macos_version macos_build architecture run_id started_at finished_at
  local procedure_rel recipe_digest procedure_digest runner_digest engine_version
  local apply_json idempotence_json operator_json draft

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --output=*) output="${1#*=}" ;;
      --engine=*) engine="${1#*=}" ;;
      --environment-id=*) environment_id="${1#*=}" ;;
      --harness-revision=*) harness_revision="${1#*=}" ;;
      *) usage ;;
    esac
    shift
  done
  [ -n "$output" ] || die "run requires --output"
  require_command jq
  require_command openssl
  [ "$(uname -s)" = "Darwin" ] || die "interactive T3 runs require macOS"

  procedure="$(procedure_path "$requested")"
  validate_procedure "$procedure"
  output="$(canonical_run_dir "$output")"
  [ ! -e "$output" ] || die "run directory already exists: $output"
  mkdir "$output"

  if [ -z "$engine" ]; then
    engine="$(command -v nix-me-apps || true)"
  fi
  [ -n "$engine" ] && [ -x "$engine" ] || die "nix-me-apps is not executable; use --engine"
  if [ -z "$environment_id" ]; then
    environment_id="$(scutil --get ComputerName 2>/dev/null || hostname)"
  fi
  if [ -z "$harness_revision" ]; then
    harness_revision="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
  fi
  case "$harness_revision" in
    *[!0-9a-f]*|'') die "a full lowercase harness revision is required" ;;
  esac
  [ "${#harness_revision}" -eq 40 ] || die "a full lowercase harness revision is required"

  procedure_rel="$(repository_relative "$procedure")"
  if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    [ "$(git -C "$REPO_ROOT" rev-parse HEAD)" = "$harness_revision" ] \
      || die "--harness-revision must match the checked-out HEAD"
    git -C "$REPO_ROOT" diff --quiet -- "$procedure_rel" \
      || die "procedure has uncommitted changes: $procedure_rel"
    git -C "$REPO_ROOT" diff --cached --quiet -- "$procedure_rel" \
      || die "procedure has staged changes not present in the harness revision: $procedure_rel"
    git -C "$REPO_ROOT" diff --quiet -- "packages/app-state/evidence/tools/t3-procedure" \
      || die "runner has uncommitted changes"
    git -C "$REPO_ROOT" diff --cached --quiet -- "packages/app-state/evidence/tools/t3-procedure" \
      || die "runner has staged changes not present in the harness revision"
  fi

  recipe="$REPO_ROOT/$(jq -r '.recipe.path' "$procedure")"
  values="$REPO_ROOT/$(jq -r '.recipe.values_path' "$procedure")"
  recipe_id="$(jq -r '.recipe.id' "$procedure")"
  app_path="$(jq -r '.recipe.app_path' "$procedure")"
  bundle_id="$(jq -r '.recipe.bundle_id' "$procedure")"
  require_file "$app_path/Contents/Info.plist"
  actual_bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app_path/Contents/Info.plist")"
  [ "$actual_bundle_id" = "$bundle_id" ] \
    || die "installed bundle id '$actual_bundle_id' does not match procedure '$bundle_id'"
  app_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app_path/Contents/Info.plist")"
  app_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$app_path/Contents/Info.plist")"
  macos_version="$(sw_vers -productVersion)"
  macos_build="$(sw_vers -buildVersion)"
  architecture="$(uname -m)"
  [ "$architecture" = "arm64" ] || [ "$architecture" = "x86_64" ] \
    || die "unsupported architecture: $architecture"
  recipe_digest="$(recipe_sha256 "$recipe")" || die "cannot normalize recipe: $recipe"
  procedure_digest="$(sha256_file "$procedure")"
  runner_digest="$(sha256_file "$SCRIPT_DIR/t3-procedure")"
  engine_version="$($engine --version 2>&1 | head -1)"
  run_id="$(basename "$output")"
  started_at="$(utc_now)"

  printf 'Running %s v%s in %s.\n' "$(jq -r '.id' "$procedure")" "$(jq -r '.version' "$procedure")" "$environment_id"
  run_engine_phase apply apply "$engine" "$recipe" "$values" "$recipe_id" "$output"
  run_engine_phase idempotence diff "$engine" "$recipe" "$values" "$recipe_id" "$output"
  operator_prompt "$procedure" "$output"
  finished_at="$(utc_now)"

  apply_json="$(cat "$output/apply-execution.json")"
  idempotence_json="$(cat "$output/idempotence-execution.json")"
  operator_json="$(cat "$output/operator.json")"
  jq -n \
    --arg schema "https://raw.githubusercontent.com/lucamaraschi/nix-me/main/packages/app-state/evidence/t3-run-record.schema.json" \
    --arg procedure_id "$(jq -r '.id' "$procedure")" \
    --argjson procedure_version "$(jq -r '.version' "$procedure")" \
    --arg procedure_path "$procedure_rel" \
    --arg procedure_sha256 "$procedure_digest" \
    --arg harness_revision "$harness_revision" \
    --arg runner_sha256 "$runner_digest" \
    --arg recipe_id "$recipe_id" \
    --arg recipe_path "$(jq -r '.recipe.path' "$procedure")" \
    --arg recipe_sha256 "$recipe_digest" \
    --arg environment_id "$environment_id" \
    --arg macos_version "$macos_version" \
    --arg macos_build "$macos_build" \
    --arg architecture "$architecture" \
    --arg bundle_id "$bundle_id" \
    --arg app_version "$app_version" \
    --arg app_build "$app_build" \
    --arg engine_path "$engine" \
    --arg engine_version "$engine_version" \
    --arg run_id "$run_id" \
    --arg started_at "$started_at" \
    --arg finished_at "$finished_at" \
    --argjson apply "$apply_json" \
    --argjson idempotence "$idempotence_json" \
    --argjson operator "$operator_json" \
    '{
      "$schema":$schema,
      record_version:1,
      origin:"interactive-t3-runner",
      procedure:{id:$procedure_id, version:$procedure_version, path:$procedure_path, sha256:$procedure_sha256, harness_revision:$harness_revision, runner_sha256:$runner_sha256},
      recipe:{id:$recipe_id, path:$recipe_path, sha256:$recipe_sha256},
      environment:{kind:"disposable_vm", identifier:$environment_id, macos:{version:$macos_version, build:$macos_build}, architecture:$architecture},
      application:{bundle_id:$bundle_id, version:$app_version, build:$app_build},
      engine:{path:$engine_path, version:$engine_version},
      run:{id:$run_id, started_at:$started_at, finished_at:$finished_at},
      commands:{apply:$apply, idempotence:$idempotence},
      operator:$operator
    }' > "$output/run-record.json"
  rm -f "$output/apply-execution.json" "$output/idempotence-execution.json" "$output/operator.json"

  draft="$output/draft-manifest.json"
  collect_draft "$output" "$draft"
  printf '\nDraft evidence written to %s\n' "$draft"
  printf 'DRAFT ONLY: it cannot stamp a recipe. Review it, then run finalize explicitly.\n'
  if [ "$(jq -r '.result.status' "$draft")" = "passed" ]; then
    return 0
  fi
  return 1
}

validate_run_record() {
  local record="$1"
  require_file "$record"
  jq empty "$record" 2>/dev/null || die "$record is not valid JSON"
  jq -e '
    .["$schema"] == "https://raw.githubusercontent.com/lucamaraschi/nix-me/main/packages/app-state/evidence/t3-run-record.schema.json"
    and .record_version == 1
    and .origin == "interactive-t3-runner"
    and (.procedure.id | type == "string" and length > 0)
    and (.procedure.version | type == "number" and . >= 1 and floor == .)
    and (.procedure.path | type == "string" and length > 0)
    and (.procedure.sha256 | test("^[0-9a-f]{64}$"))
    and (.procedure.harness_revision | test("^[0-9a-f]{40}$"))
    and (.procedure.runner_sha256 | test("^[0-9a-f]{64}$"))
    and (.recipe.id | type == "string" and length > 0)
    and (.recipe.path | type == "string" and length > 0)
    and (.recipe.sha256 | test("^[0-9a-f]{64}$"))
    and .environment.kind == "disposable_vm"
    and (.environment.identifier | type == "string" and length > 0)
    and (.environment.macos.version | type == "string" and length > 0)
    and (.environment.macos.build | type == "string" and length > 0)
    and (.environment.architecture == "arm64" or .environment.architecture == "x86_64")
    and (.application.bundle_id | type == "string" and length > 0)
    and (.application.version | type == "string" and length > 0)
    and (.application.build | type == "string" and length > 0)
    and (.run.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and (.run.started_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
    and (.run.finished_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
    and .run.finished_at >= .run.started_at
    and (.commands.apply | type == "object")
    and (.commands.idempotence | type == "object")
    and (.operator | type == "object")
  ' "$record" >/dev/null || die "$record does not satisfy the T3 run-record contract"
}

command_check_passes() {
  local run_dir="$1"
  local record="$2"
  local procedure="$3"
  local phase="$4"
  local output stderr exit_code expected_mode

  output="$(jq -r --arg phase "$phase" '.commands[$phase].output // empty' "$record")"
  stderr="$(jq -r --arg phase "$phase" '.commands[$phase].stderr // empty' "$record")"
  exit_code="$(jq -r --arg phase "$phase" '.commands[$phase].exit_code // -1' "$record")"
  expected_mode="$(jq -r --arg phase "$phase" '.execution[$phase].mode' "$procedure")"
  [ "$output" = "$phase.log" ] || return 1
  [ -s "$run_dir/$output" ] || return 1
  [ "$(sha256_file "$run_dir/$output")" = "$(jq -r --arg phase "$phase" '.commands[$phase].output_sha256 // empty' "$record")" ] \
    || return 1
  [ "$(file_bytes "$run_dir/$output")" = "$(jq -r --arg phase "$phase" '.commands[$phase].output_bytes // -1' "$record")" ] \
    || return 1
  [ "$stderr" = "$phase.stderr.log" ] && [ -f "$run_dir/$stderr" ] || return 1
  [ "$(sha256_file "$run_dir/$stderr")" = "$(jq -r --arg phase "$phase" '.commands[$phase].stderr_sha256 // empty' "$record")" ] \
    || return 1
  [ "$(file_bytes "$run_dir/$stderr")" = "$(jq -r --arg phase "$phase" '.commands[$phase].stderr_bytes // -1' "$record")" ] \
    || return 1
  jq empty "$run_dir/$output" 2>/dev/null || return 1
  jq -e --arg phase "$phase" --argjson code "$exit_code" \
    '.execution[$phase].accepted_exit_codes | index($code) != null' "$procedure" >/dev/null || return 1
  jq -e --arg mode "$expected_mode" --argjson code "$exit_code" \
    '.mode == $mode and .exit_code == $code' "$run_dir/$output" >/dev/null || return 1
  jq -e '[.apps[]?.entries[]?.drift[]?] | length == 0' "$run_dir/$output" >/dev/null || return 1
  jq -e '[.apps[]?.entries[]?.actions[]? | select(.result != "ok")] | length == 0' \
    "$run_dir/$output" >/dev/null || return 1
  jq -e --slurpfile procedure "$procedure" --arg phase "$phase" '
    ($procedure[0].execution[$phase].required_action_ops) as $required
    | [.apps[]?.entries[]?.actions[]?.op] as $actual
    | all($required[]; . as $op | $actual | index($op) != null)
  ' "$run_dir/$output" >/dev/null || return 1
  if [ "$phase" = "idempotence" ]; then
    jq -e '[.apps[]?.entries[]?.actions[]?] | length == 0' "$run_dir/$output" >/dev/null || return 1
  fi
}

operator_check_passes() {
  local run_dir="$1"
  local record="$2"
  local procedure="$3"
  local report artifact media expected_sha expected_bytes confirmation challenge

  jq -e '.operator.attested == true' "$record" >/dev/null || return 1
  jq -e '.operator.identity | type == "string" and length > 0' "$record" >/dev/null || return 1
  jq -e '.operator.observation | type == "string" and length > 0' "$record" >/dev/null || return 1
  challenge="$(jq -r '.operator.challenge // empty' "$record")"
  confirmation="$(jq -r '.operator.confirmation // empty' "$record")"
  [ -n "$challenge" ] && [ "$confirmation" = "PASS $challenge" ] || return 1
  report="$(jq -r '.operator.report // empty' "$record")"
  [ "$report" = "operator-observation.txt" ] && [ -s "$run_dir/$report" ] || return 1
  [ "$(sha256_file "$run_dir/$report")" = "$(jq -r '.operator.report_sha256 // empty' "$record")" ] \
    || return 1
  [ "$(file_bytes "$run_dir/$report")" = "$(jq -r '.operator.report_bytes // -1' "$record")" ] \
    || return 1
  artifact="$(jq -r '.operator.artifact.path // empty' "$record")"
  case "$artifact" in
    visible-artifact.png|visible-artifact.jpg|visible-artifact.mov|visible-artifact.mp4) ;;
    *) return 1 ;;
  esac
  [ -s "$run_dir/$artifact" ] || return 1
  media="$(jq -r '.operator.artifact.media_type // empty' "$record")"
  jq -e --arg media "$media" '.operator.artifact.allowed_media_types | index($media) != null' \
    "$procedure" >/dev/null || return 1
  [ "$(media_type_for_path "$artifact")" = "$media" ] || return 1
  expected_sha="$(jq -r '.operator.artifact.sha256 // empty' "$record")"
  expected_bytes="$(jq -r '.operator.artifact.bytes // 0' "$record")"
  [ "$(sha256_file "$run_dir/$artifact")" = "$expected_sha" ] || return 1
  [ "$(file_bytes "$run_dir/$artifact")" = "$expected_bytes" ] || return 1
}

add_artifact() {
  local artifacts_file="$1"
  local id="$2"
  local kind="$3"
  local file="$4"
  local media_type="$5"
  local captured_at="$6"
  local description="$7"
  local next

  [ -s "$file" ] || return 1
  next="${artifacts_file}.next"
  jq \
    --arg id "$id" \
    --arg kind "$kind" \
    --arg path "$(repository_relative "$file")" \
    --arg media_type "$media_type" \
    --arg sha256 "$(sha256_file "$file")" \
    --argjson bytes "$(file_bytes "$file")" \
    --arg captured_at "$captured_at" \
    --arg description "$description" \
    '. + [{id:$id, kind:$kind, path:$path, media_type:$media_type, sha256:$sha256, bytes:$bytes, captured_at:$captured_at, description:$description}]' \
    "$artifacts_file" > "$next"
  mv "$next" "$artifacts_file"
}

build_draft_manifest() {
  local run_dir="$1"
  local output="$2"
  local record="$run_dir/run-record.json"
  local procedure procedure_rel artifacts_file artifacts_json
  local apply_ok=false idempotence_ok=false visible_ok=false result_status=failed
  local apply_status=failed idempotence_status=failed visible_status=failed
  local apply_refs='["run-record"]' idempotence_refs='["run-record"]' visible_refs='["run-record"]'
  local summary artifact_path artifact_media artifact_kind tmp

  validate_run_record "$record"
  [ "$(jq -r '.run.id' "$record")" = "$(basename "$run_dir")" ] \
    || die "$record: run.id must match its run directory"
  procedure_rel="$(jq -r '.procedure.path' "$record")"
  case "/$procedure_rel/" in
    */../*) die "$record: procedure.path contains '..'" ;;
  esac
  case "$procedure_rel" in
    packages/app-state/evidence/procedures/*.v*.json) ;;
    *) die "$record: procedure.path is not a versioned repository procedure" ;;
  esac
  procedure="$REPO_ROOT/$procedure_rel"
  validate_procedure "$procedure"
  [ "$(jq -r '.procedure.id' "$record")" = "$(jq -r '.id' "$procedure")" ] \
    || die "$record: procedure id does not match $procedure_rel"
  [ "$(jq -r '.procedure.version' "$record")" = "$(jq -r '.version' "$procedure")" ] \
    || die "$record: procedure version does not match $procedure_rel"
  [ "$(jq -r '.procedure.sha256' "$record")" = "$(sha256_file "$procedure")" ] \
    || die "$record: procedure digest does not match $procedure_rel"
  [ "$(jq -r '.recipe.id' "$record")" = "$(jq -r '.recipe.id' "$procedure")" ] \
    || die "$record: recipe id does not match the procedure"
  [ "$(jq -r '.recipe.path' "$record")" = "$(jq -r '.recipe.path' "$procedure")" ] \
    || die "$record: recipe path does not match the procedure"
  [ "$(jq -r '.recipe.sha256' "$record")" = "$(recipe_sha256 "$REPO_ROOT/$(jq -r '.recipe.path' "$procedure")")" ] \
    || die "$record: recipe digest does not match the procedure input"
  [ "$(jq -r '.application.bundle_id' "$record")" = "$(jq -r '.recipe.bundle_id' "$procedure")" ] \
    || die "$record: application bundle id does not match the procedure"

  command_check_passes "$run_dir" "$record" "$procedure" apply && apply_ok=true
  command_check_passes "$run_dir" "$record" "$procedure" idempotence && idempotence_ok=true
  operator_check_passes "$run_dir" "$record" "$procedure" && visible_ok=true
  [ "$apply_ok" = true ] && apply_status=passed
  [ "$idempotence_ok" = true ] && idempotence_status=passed
  [ "$visible_ok" = true ] && visible_status=passed
  if [ "$apply_ok" = true ] && [ "$idempotence_ok" = true ] && [ "$visible_ok" = true ]; then
    result_status=passed
    summary="Draft collection contains successful machine checks and explicit operator evidence; it still requires finalization."
  else
    summary="Draft collection is incomplete or failed and is not eligible for finalization or stamping."
  fi

  artifacts_file="$(mktemp "$EVIDENCE_DIR/.artifacts.XXXXXX")"
  printf '[]\n' > "$artifacts_file"
  add_artifact "$artifacts_file" run-record report "$record" application/json \
    "$(jq -r '.run.finished_at' "$record")" "Interactive runner record and captured environment metadata."
  if [ -s "$run_dir/apply.log" ]; then
    add_artifact "$artifacts_file" apply-log log "$run_dir/apply.log" application/json \
      "$(jq -r '.commands.apply.finished_at' "$record")" "First app-state apply output."
    apply_refs='["apply-log"]'
  fi
  if [ -s "$run_dir/apply.stderr.log" ]; then
    add_artifact "$artifacts_file" apply-stderr log "$run_dir/apply.stderr.log" text/plain \
      "$(jq -r '.commands.apply.finished_at' "$record")" "First app-state apply standard error and interactive prompt output."
    apply_refs="$(printf '%s' "$apply_refs" | jq '. + ["apply-stderr"]')"
  fi
  if [ -s "$run_dir/idempotence.log" ]; then
    add_artifact "$artifacts_file" idempotence-log log "$run_dir/idempotence.log" application/json \
      "$(jq -r '.commands.idempotence.finished_at' "$record")" "Post-apply idempotence diff output."
    idempotence_refs='["idempotence-log"]'
  fi
  if [ -s "$run_dir/idempotence.stderr.log" ]; then
    add_artifact "$artifacts_file" idempotence-stderr log "$run_dir/idempotence.stderr.log" text/plain \
      "$(jq -r '.commands.idempotence.finished_at' "$record")" "Post-apply idempotence diff standard error output."
    idempotence_refs="$(printf '%s' "$idempotence_refs" | jq '. + ["idempotence-stderr"]')"
  fi
  if [ -s "$run_dir/operator-observation.txt" ]; then
    add_artifact "$artifacts_file" operator-observation report "$run_dir/operator-observation.txt" text/plain \
      "$(jq -r '.operator.observed_at' "$record")" "Operator-entered observation and challenge response."
    visible_refs='["operator-observation"]'
  fi
  artifact_path="$(jq -r '.operator.artifact.path // empty' "$record")"
  if [ -n "$artifact_path" ] && [ -s "$run_dir/$artifact_path" ]; then
    artifact_media="$(jq -r '.operator.artifact.media_type' "$record")"
    case "$artifact_media" in
      image/*) artifact_kind=screenshot ;;
      video/*) artifact_kind=video ;;
      *) artifact_kind=report ;;
    esac
    add_artifact "$artifacts_file" visible-artifact "$artifact_kind" "$run_dir/$artifact_path" "$artifact_media" \
      "$(jq -r '.operator.observed_at' "$record")" "$(jq -r '.operator.artifact.description' "$procedure")"
    visible_refs="$(printf '%s' "$visible_refs" | jq '. + ["visible-artifact"]')"
  fi
  artifacts_json="$(cat "$artifacts_file")"
  rm -f "$artifacts_file"

  tmp="${output}.tmp.$$"
  jq -n \
    --arg schema "https://raw.githubusercontent.com/lucamaraschi/nix-me/main/packages/app-state/evidence/t3-evidence-manifest.schema.json" \
    --arg recipe_id "$(jq -r '.recipe.id' "$record")" \
    --arg recipe_path "$(jq -r '.recipe.path' "$record")" \
    --arg recipe_sha256 "$(jq -r '.recipe.sha256' "$record")" \
    --arg environment_kind "$(jq -r '.environment.kind' "$record")" \
    --arg environment_id "$(jq -r '.environment.identifier' "$record")" \
    --arg macos_version "$(jq -r '.environment.macos.version' "$record")" \
    --arg macos_build "$(jq -r '.environment.macos.build' "$record")" \
    --arg architecture "$(jq -r '.environment.architecture' "$record")" \
    --arg bundle_id "$(jq -r '.application.bundle_id' "$record")" \
    --arg app_version "$(jq -r '.application.version' "$record")" \
    --arg app_build "$(jq -r '.application.build' "$record")" \
    --arg procedure_id "$(jq -r '.procedure.id' "$record")" \
    --argjson procedure_version "$(jq -r '.procedure.version' "$record")" \
    --arg harness_revision "$(jq -r '.procedure.harness_revision' "$record")" \
    --arg run_id "$(jq -r '.run.id' "$record")" \
    --arg started_at "$(jq -r '.run.started_at' "$record")" \
    --arg finished_at "$(jq -r '.run.finished_at' "$record")" \
    --arg result_status "$result_status" \
    --arg summary "$summary" \
    --arg apply_status "$apply_status" \
    --arg idempotence_status "$idempotence_status" \
    --arg visible_status "$visible_status" \
    --argjson apply_refs "$apply_refs" \
    --argjson idempotence_refs "$idempotence_refs" \
    --argjson visible_refs "$visible_refs" \
    --argjson artifacts "$artifacts_json" \
    '{
      "$schema":$schema,
      schema_version:1,
      lifecycle:"draft",
      recipe:{id:$recipe_id, path:$recipe_path, sha256:$recipe_sha256},
      environment:{kind:$environment_kind, identifier:$environment_id, macos:{version:$macos_version, build:$macos_build}, architecture:$architecture},
      application:{bundle_id:$bundle_id, version:$app_version, build:$app_build},
      procedure:{id:$procedure_id, version:$procedure_version, harness_revision:$harness_revision},
      run:{id:$run_id, started_at:$started_at, finished_at:$finished_at},
      result:{
        status:$result_status,
        summary:$summary,
        checks:{
          apply:{status:$apply_status, note:(if $apply_status == "passed" then "Apply output, exit code, required actions, and action results passed validation." else "Apply output, exit code, required actions, or action results failed validation." end), artifact_ids:$apply_refs},
          visible_behavior:{status:$visible_status, note:(if $visible_status == "passed" then "An identified operator explicitly attested to every criterion and supplied the required retained artifact." else "Operator attestation, challenge response, observation, or required visual artifact is missing or invalid." end), artifact_ids:$visible_refs},
          idempotence:{status:$idempotence_status, note:(if $idempotence_status == "passed" then "The post-apply diff contained no actions or drift." else "The post-apply diff is missing, failed, or contains actions or drift." end), artifact_ids:$idempotence_refs}
        }
      },
      artifacts:$artifacts
    }' > "$tmp"
  "$EVIDENCE_TOOL" validate-manifest "$tmp" >/dev/null
  mv "$tmp" "$output"
}

collect_draft() {
  local requested="$1"
  local output="${2:-}"
  local run_dir

  run_dir="$(canonical_run_dir "$requested")"
  [ -d "$run_dir" ] || die "run directory not found: $run_dir"
  if [ -z "$output" ]; then
    output="$run_dir/draft-manifest.json"
  fi
  build_draft_manifest "$run_dir" "$output"
  printf 'Collected draft evidence: %s (%s)\n' "$output" "$(jq -r '.result.status' "$output")"
}

finalize_manifest() {
  local requested="$1"
  local output="$2"
  local run_dir record recipe_id revision procedure_rel procedure_digest runner_digest
  local output_parent expected_parent temporary final_tmp

  run_dir="$(canonical_run_dir "$requested")"
  [ -d "$run_dir" ] || die "run directory not found: $run_dir"
  record="$run_dir/run-record.json"
  validate_run_record "$record"
  recipe_id="$(jq -r '.recipe.id' "$record")"
  output_parent="$(cd "$(dirname "$output")" 2>/dev/null && pwd -P || true)"
  expected_parent="$EVIDENCE_DIR/manifests"
  [ "$output_parent" = "$expected_parent" ] \
    || die "final manifests must be written directly under $expected_parent"
  [ "$(basename "$output")" = "$recipe_id.json" ] \
    || die "final manifest must be named $recipe_id.json"

  temporary="$(mktemp "$EVIDENCE_DIR/.draft.XXXXXX")"
  final_tmp="$(mktemp "$EVIDENCE_DIR/.final.XXXXXX")"
  trap 'rm -f "$temporary" "$final_tmp"' EXIT
  build_draft_manifest "$run_dir" "$temporary"
  [ "$(jq -r '.result.status' "$temporary")" = "passed" ] \
    || die "run checks did not pass; refusing to finalize"

  revision="$(jq -r '.procedure.harness_revision' "$record")"
  procedure_rel="$(jq -r '.procedure.path' "$record")"
  procedure_digest="$(git -C "$REPO_ROOT" show "$revision:$procedure_rel" 2>/dev/null | sha256_stdin)" \
    || die "harness revision does not contain $procedure_rel: $revision"
  [ "$procedure_digest" = "$(jq -r '.procedure.sha256' "$record")" ] \
    || die "recorded procedure does not match harness revision $revision"
  runner_digest="$(git -C "$REPO_ROOT" show "$revision:packages/app-state/evidence/tools/t3-procedure" 2>/dev/null | sha256_stdin)" \
    || die "harness revision does not contain the T3 runner: $revision"
  [ "$runner_digest" = "$(jq -r '.procedure.runner_sha256' "$record")" ] \
    || die "recorded runner does not match harness revision $revision"
  [ "$(recipe_sha256 "$REPO_ROOT/$(jq -r '.recipe.path' "$record")")" = "$(jq -r '.recipe.sha256' "$record")" ] \
    || die "recipe changed after the recorded run"
  [ ! -e "$output" ] || die "refusing to overwrite final manifest: $output"

  jq '.lifecycle = "final"' "$temporary" > "$final_tmp"
  "$EVIDENCE_TOOL" validate-manifest "$final_tmp" >/dev/null
  mv "$final_tmp" "$output"
  trap - EXIT
  rm -f "$temporary"
  printf 'Final evidence manifest written: %s\n' "$output"
  printf 'The recipe is still unstamped; review the final manifest before invoking evidence-tool stamp-recipe.\n'
}

[ "$#" -ge 1 ] || usage
command="$1"
shift

case "$command" in
  validate)
    validate_all "$@"
    ;;
  run)
    [ "$#" -ge 1 ] || usage
    requested="$1"
    shift
    run_procedure "$requested" "$@"
    ;;
  collect-draft)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
    collect_draft "$@"
    ;;
  finalize)
    [ "$#" -eq 2 ] || usage
    finalize_manifest "$1" "$2"
    ;;
  *) usage ;;
esac
