{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lucamaraschi/nix-me/main/packages/app-state/evidence/t3-evidence-manifest.schema.json",
  "title": "nix-me T3 recipe evidence manifest",
  "description": "Version 1 evidence retained after a visible application-behavior verification run.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "lifecycle",
    "recipe",
    "environment",
    "application",
    "procedure",
    "run",
    "result",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/lucamaraschi/nix-me/main/packages/app-state/evidence/t3-evidence-manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "lifecycle": {
      "enum": ["draft", "final"],
      "description": "Draft evidence is reviewable but never eligible to stamp a recipe."
    },
    "recipe": {
      "type": "object",
      "required": ["id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "description": "Repository-relative path with no parent-directory components."
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the recipe after normalizing its top-level verified value to null."
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["kind", "identifier", "macos", "architecture"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["disposable_vm", "dedicated_host"]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "Stable VM image or dedicated-host identity used for the run."
        },
        "macos": {
          "type": "object",
          "required": ["version", "build"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "pattern": "^[0-9]+([.][0-9]+){1,2}$" },
            "build": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" }
          }
        },
        "architecture": {
          "enum": ["arm64", "x86_64"]
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["bundle_id", "version", "build"],
      "additionalProperties": false,
      "properties": {
        "bundle_id": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "procedure": {
      "type": "object",
      "required": ["id", "version", "harness_revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "harness_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Git commit containing the procedure that was executed."
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "started_at", "finished_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "result": {
      "type": "object",
      "required": ["status", "summary", "checks"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "summary": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "object",
          "required": ["apply", "visible_behavior", "idempotence"],
          "additionalProperties": false,
          "properties": {
            "apply": { "$ref": "#/$defs/check" },
            "visible_behavior": { "$ref": "#/$defs/check" },
            "idempotence": { "$ref": "#/$defs/check" }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "check": {
      "type": "object",
      "required": ["status", "note", "artifact_ids"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "note": { "type": "string", "minLength": 1 },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "path", "media_type", "sha256", "bytes", "captured_at", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "enum": ["screenshot", "video", "log", "report", "export"] },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "description": "Repository-relative retained artifact path with no parent-directory components."
        },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[A-Za-z0-9.+-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
