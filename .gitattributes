# Exclude tests and docs from exports and archives
tests/ export-ignore
docs/ export-ignore

# Exclude development and documentation files
.github/ export-ignore
.gitignore export-ignore
.gitattributes export-ignore

# Production T3 recordings are durable evidence without bloating Git history.
packages/app-state/evidence/runs/**/visible-artifact.mov filter=lfs diff=lfs merge=lfs -text
packages/app-state/evidence/runs/**/visible-artifact.mp4 filter=lfs diff=lfs merge=lfs -text
